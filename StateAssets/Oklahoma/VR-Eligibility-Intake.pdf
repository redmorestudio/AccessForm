						<div>
							<picture>
								<source media="(max-width: 767px)" srcset="/content/dam/ok/en/okdrs/images/mediareleases/2025/sbvi/Hellen Keller.jpg.transform/medium/img.jpg"/>
								<source media="(max-width: 1023px)" srcset="/content/dam/ok/en/okdrs/images/mediareleases/2025/sbvi/Hellen Keller.jpg.transform/large/img.jpg"/>
								<source media="(min-width: 1920px)" srcset="/content/dam/ok/en/okdrs/images/mediareleases/2025/sbvi/Hellen Keller.jpg.transform/xlarge/img.jpg"/>
