            <div class="cmp-teaser__image">
               <a class="cmp-image__link" target="_parent" role="img" alt="Brent-and-Mark">
                  <div>
                     <picture>
                        <source media="(max-width: 767px)" srcset="/content/dam/ok/en/okdrs/images/mediareleases/2025/exec/Brent-and-Mark.jpg.transform/medium/img.jpg"/>
