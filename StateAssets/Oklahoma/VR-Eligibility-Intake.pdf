      <div class="teaser sok__teaser--text-right">
         <div class="cmp-teaser">
            <div class="cmp-teaser__image">
               <a class="cmp-image__link" target="_parent" role="img" alt="OSD Bison photo collage of all the players on the team.">
                  <div>
                     <picture>
                        <source media="(max-width: 767px)" srcset="/content/dam/ok/en/okdrs/images/mediareleases/2024/osd/OSD Football Team.png.transform/medium/img.png"/>
