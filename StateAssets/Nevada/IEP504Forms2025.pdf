}],[\"$\",\"div\",null,{\"className\":\"style_title__DqnyY\",\"children\":\"NV Educator Performance Framework (NEPF)\"}]]}],[\"$\",\"a\",null,{\"href\":\"/offices/craleo/cte/\",\"target\":\"_self\",\"role\":\"button\",\"className\":\"style_icon-card-container__wK9xF\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://webapp-strapi-paas-prod-nde-001.azurewebsites.net/uploads/Podium_b6dfc86b38.svg\",\"alt\":\"Image of a person on a podium\",\"decoding\":\"async\"}],[\"$\",\"div\",null,{\"className\":\"style_title__DqnyY\",\"children\":\"Career and Technical Education (CTE)\"}]]}],[\"$\",\"a\",null,{\"href\":\"https://doe.nv.gov/offices/osrle/school-safety/safe-voice\",\"target\":\"_self\",\"role\":\"button\",\"className\":\"style_icon-card-container__wK9xF\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://webapp-strapi-paas-prod-nde-001.azurewebsites.net/uploads/safe_Voice_32cab79912.svg\",\"alt\":\"Image of 2 message bubbles\",\"decoding\":\"async\"}],[\"$\",\"div\",null,{\"className\":\"style_title__DqnyY\",\"children\":\"SafeVoice\"}]]}]]}]}]}],[\"$\",\"section\",null,{\"className\":\"style_nvd-section__oFbqm\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"style_homePage-h2__dl3sI\",\"children\":\"Inside NDE\"}],[\"$\",\"$L11\",null,{\"carousel\":{\"__typename\":\"CarouselEntityResponse\",\"data\":{\"__typename\":\"CarouselEntity\",\"id\":\"4\",\"attributes\":{\"__typename\":\"Carousel\",\"Name\":\"HOMEPAGE-Superintendent\",\"Slide\":[{\"__typename\":\"ComponentElementsCarouselSlide\",\"id\":\"16\",\"slide_name\":\"Steve Canavero\",\"image\":{\"__typename\":\"UploadFileEntityResponse\",\"data\":{\"__typename\":\"UploadFileEntity\",\"id\":\"12849\",\"attributes\":{\"__typename\":\"UploadFile\",\"alternativeText\":\"Steve Canavero\",\"caption\":null,\"url\":\"/uploads/steve_canavero_homepage_5f41b3e19a.png\"}}},\"content_block\":{\"__typename\":\"ComponentElementsCarouselCb\",\"id\":\"6\",\"heading\":\"Steve Canavero\",\"eyebrow\":\"FROM STATE INTERIM SUPERINTENDENT\",\"body\":\"Welcome to the Nevada Department of Education's (NDE) website! Whether you are an educator looking to renew your license, a parent or family member seeking information about our work on behalf of students, or a constituent following the work of our State Board of Education or other Boards or Commissions, this site will help you find what you need. Our team works every single day to support students and families, teachers, principals, and administrators throughout our great state and to ensure that public funds are used efficiently and effectively to give students the tools they need to build a home, a life, and a future.\",\"Text\":\"More about Steve\",\"URL\":\"/about/executive-team/\",\"link_target_page\":{\"__typename\":\"PageEntityResponse\",\"data\":null},\"BioLayout\":true}}]}}},\"fromFeatureRegion\":true}]]}],[\"$\",\"section\",null,{\"className\":\"style_nvd-section__oFbqm\",\"children\":[\"$\",\"div\",null,{\"className\":\"style_card-group-container__Ib3sX\",\"children\":[[\"$\",\"div\",null,{\"className\":\"style_card-container__ayTEx style_lahontan__vxPP2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"style_image-container__7ZtvO\",\"children\":[\"$\",\"img\",null,{\"src\":\"https://webapp-strapi-paas-prod-nde-001.azurewebsites.net/uploads/mission_statement_image_675e93031e.JPEG\",\"alt\":\"mission-statement-image\"}]}],[\"$\",\"div\",null,{\"className\":\"style_card-content__F7tMJ\",\"children\":[[\"$\",\"div\",null,{\"className\":\"style_card-title__NBPZ3\",\"children\":\"Mission Statement\"}],[\"$\",\"p\",null,{\"children\":\"Our mission is to improve student achievement and educator effectiveness by ensuring opportunities, facilitating learning, and promoting excellence.\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"style_card-container__ayTEx style_sageBrush__Ozt3F\",\"children\":[[\"$\",\"div\",null,{\"className\":\"style_image-container__7ZtvO\",\"children\":[\"$\",\"img\",null,{\"src\":\"https://webapp-strapi-paas-prod-nde-001.azurewebsites.net/uploads/celebrating_and_supporting_current_and_future_educators_db261e84be.JPG\",\"alt\":\"Image of teachers\"}]}],[\"$\",\"div\",null,{\"className\":\"style_card-content__F7tMJ\",\"children\":[[\"$\",\"div\",null,{\"className\":\"style_card-title__NBPZ3\",\"children\":\"Celebrating \u0026 Supporting Current and Future Educators\"}],[\"$\",\"p\",null,{\"children\":\"The mission of the Nevada Teacher of the Year program is to celebrate excellence and strengthen the teaching force by honoring and recognizing exceptional teachers on a school, district, state, and national level.\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"style_card-container__ayTEx style_silverState__uFLU2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"style_image-container__7ZtvO\",\"children\":[\"$\",\"img\",null,{\"src\":\"https://webapp-strapi-paas-prod-nde-001.azurewebsites.net/uploads/transparency_and_reliability_image_501f57880e.JPG\",\"alt\":\"transparency-and-reliability-image\"}]}],[\"$\",\"div\",null,{\"className\":\"style_card-content__F7tMJ\",\"children\":[[\"$\",\"div\",null,{\"className\":\"style_card-title__NBPZ3\",\"children\":\"Transparency \u0026 Reliability\"}],[\"$\",\"p\",null,{\"children\":\"Districts, schools, and communities are served through efficient and effective use of public funds and fulfillment of statutory responsibilities.\"}]]}]]}]]}]}],[\"$\",\"section\",null,{\"className\":\"style_nvd-section__oFbqm\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"style_homePage-h2__dl3sI\",\"children\":\"We Teach Nevada\"}],[\"$\",\"$L12\",null,{\"Youtube_Url\":{\"__typename\":\"ComponentComponentsSocialMedia\",\"id\":\"1\",\"Youtube_Url\":\"https://www.youtube.com/watch?v=shuPZdPRqgk\",\"disp_yt_twtr\":true,\"disp_instagrm\":false},\"instagramMedia\":{\"__typename\":\"InstagramDataEntityResponse\",\"data\":{\"__typename\":\"InstagramDataEntity\",\"attributes\":{\"__typename\":\"InstagramData\",\"INSTA_TOKEN\":\"IGQWRPcHNjcHllM1FneTRKOU9vRXV4eEFXWlRuSkM2WDJHUUotUzRfeVNZATU1fR1JYT0ZAVaktxaFNiVnB0ZAWNFR2VKNVE1ZAVd0ZAml4ZA2hLd2toWEpZAdk9sQ2ZAzaGJvQzBfYkUzVnpoY04xdwZDZD\",\"INSTA_MEDIA\":[{\"id\":\"17843605794367935\",\"caption\":\"Happy ? Thanksgiving from the Nevada Department of Education! Thank you to our school community in Nevada for your dedication, passion, and commitment to inspiring learning and growth every day. \\n\\nWishing everyone a safe, joyful, and memorable holiday! ?? #HappyThanksgiving #ThanksgivingDay\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/468698303_2484426578555654_7358100888577400676_n.jpg?_nc_cat=100\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=NvK2aY21mAoQ7kNvgFj4U1B\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYBZlhKFmbw0iiGNOzqmUW486J8vGCg1V2LXhoQAe_Z5Lg\u0026oe=67555CB1\",\"permalink\":\"https://www.instagram.com/p/DC68oV9gcaZ/\",\"timestamp\":\"2024-11-28T16:03:16+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18468957514053102\",\"caption\":\"Your insights and collaboration are essential as we continue driving innovation and equity in education across our state. This virtual session on December 11th is an opportunity to:\\n\\n? Learn about the Commission’s policy recommendations ahead of the next legislative session.\\n\\n? Explore how the Portrait of a Nevada Learner and the Network are grounding these policy discussions.\\n\\n?Connect with education leaders, community members, and other stakeholders working to shape Nevada’s future.\\n\\nRegister through the link in bio!\\n.\\n.\\nPosted @withregram • @portraitofanvlearner\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.29350-15/468730013_1082138339835178_8703064011452139013_n.jpg?_nc_cat=107\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=Zj31CHdbqrMQ7kNvgFv4bOS\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026_nc_gid=AuR3WKuygjDdn7rqbzhJWiN\u0026oh=00_AYDHHDbNtAIHUrT3p0u487Qte7-DTyMz9m7qiSKrpNnH1A\u0026oe=675559C9\",\"permalink\":\"https://www.instagram.com/p/DC4_zvMzWK1/\",\"timestamp\":\"2024-11-27T21:52:31+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18065759989686303\",\"caption\":\"Nevada Department of Education offices will be closed for the #Thanksgiving holiday on Thursday, Nov. 28 and Friday, Nov. 29. Offices will reopen on Monday, Dec. 2. Have a joyful and peaceful Thanksgiving! ???\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/468584691_3969379260017017_3158698142795703959_n.jpg?_nc_cat=106\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=KKHaP5UHIBAQ7kNvgE0ZSDq\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYBzmHh6p_uZmb48sv6D_SuwSw3-_avnXZ-YXj-9vTIsVA\u0026oe=67556580\",\"permalink\":\"https://www.instagram.com/p/DC4t8lHPHJo/\",\"timestamp\":\"2024-11-27T19:16:29+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18068224543672019\",\"caption\":\"It’s #TeacherTuesday and today we’re celebrating Mrs. Edie Guerra from Gunderson Middle School. She plays a key role as a teacher leader within the Clark County School District, mentoring new teachers and those new to science. Her passion lies in empowering educators to recognize the positive impact they make.\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/468476560_475104671761264_1226239798769257929_n.jpg?_nc_cat=106\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=x46Bpya7vwYQ7kNvgHTDAu2\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYCEq0shHJBp_wkr7V9W0ystnCTcX0zBPVcz3WmkVFLoaw\u0026oe=675547BD\",\"permalink\":\"https://www.instagram.com/p/DC2oY0_vHeF/\",\"timestamp\":\"2024-11-26T23:49:25+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"17968023854805167\",\"caption\":\"#NowHiring NDE is seeking an Educator Licensing Analyst I within the Office of Educator Development, Licensure, and Family Engagement. The incumbent will evaluate transcripts and determine eligibility for educator licensure for one of two geographical divisions of the State. Visit the link in our bio for more information.\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/468324370_545511334964985_7450066099355625679_n.jpg?_nc_cat=110\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=5swyylluau0Q7kNvgG-4eK9\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYB7brC4DkIsaTwTQKE_qXEzk0ChQASkCPJGC9cq8ph87w\u0026oe=67554E19\",\"permalink\":\"https://www.instagram.com/p/DCz3tfGPmC0/\",\"timestamp\":\"2024-11-25T22:05:36+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18041861942174878\",\"caption\":\"During a ceremony today to celebrate Roger D. Gehring Academy of Science and Technology being named a 2024 National Blue Ribbon School, students did a wonderful job singing the school song! ?\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/o1/v/t16/f1/m86/F04BAAD4AD45200E36431A5903657DBF_video_dashinit.mp4?efg=eyJ4cHZfYXNzZXRfaWQiOjUxODQyNDU0Nzg2MjM3NiwidmVuY29kZV90YWciOiJ4cHZfcHJvZ3Jlc3NpdmUuSU5TVEFHUkFNLkNMSVBTLkMzLjEyODAuZGFzaF9iYXNlbGluZV8xX3YxIn0\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026_nc_cat=102\u0026vs=e394aa18a56f396d\u0026_nc__gcA\u0026ccb=9-4\u0026oh=00_AYDzu2cg883YiBixacMIL-U-qHU8eyKL0M91mzDlvVItSw\u0026oe=675179F4\u0026_nc_sid=1d576d\",\"permalink\":\"https://www.instagram.com/reel/DCsFSmwN4oD/\",\"timestamp\":\"2024-11-22T21:35:06+0000\",\"media_type\":\"VIDEO\"},{\"id\":\"18084621055536627\",\"caption\":\"Congratulations to Roger D. Gehring Academy of Science and Technology for being named a 2024 National Blue Ribbon School! The school held a ceremony today to celebrate this remarkable accomplishment.\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/467868062_1987626335086012_1744750268971546224_n.jpg?_nc_cat=109\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=Ss8UHb5JLfUQ7kNvgGAuFSc\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYCVKjDAxNwLf7vPuzhxIFPNrpCdmjUr8kC7GzfzUsTDdw\u0026oe=67554BEF\",\"permalink\":\"https://www.instagram.com/p/DCr7aLxvRKb/\",\"timestamp\":\"2024-11-22T20:04:16+0000\",\"media_type\":\"CAROUSEL_ALBUM\"},{\"id\":\"18250615258277055\",\"caption\":\"$13\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/467857250_1941453889691949_5941619058566564595_n.jpg?_nc_cat=108\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=c9dnd3cBQssQ7kNvgFjT5WH\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYAyjms1IfPCEKyS89Dka8PHTLk-YednAmx2eaNTKk6JUQ\u0026oe=67557466\",\"permalink\":\"https://www.instagram.com/p/DCr3WCvsrM5/\",\"timestamp\":\"2024-11-22T19:28:47+0000\",\"media_type\":\"CAROUSEL_ALBUM\"},{\"id\":\"18143732395318906\",\"caption\":\"#NowHiring NDE is seeking an Education Programs Professional within the Office of  Career Readiness, Adult Learning, and Education Options. This position is responsible for overseeing the administration of Nevada's Career and Technical Education's (CTE) program areas. Visit the link in our bio to apply.\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/468033737_1209112710683168_678268162239703153_n.jpg?_nc_cat=105\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=xIP2y6bfQ1wQ7kNvgGaCbTM\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYBOe6iPkYwH-RiCcSR4yoRh1DU7pKqSw1mGIRKiIUM3ew\u0026oe=67555C06\",\"permalink\":\"https://www.instagram.com/p/DCr3YIRTIfL/\",\"timestamp\":\"2024-11-22T19:28:46+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18106967254445863\",\"caption\":\"Do you have 10-15 minutes? The new NV Working Conditions Survey is now open for all school staff. We want to hear from you! This statewide survey is an opportunity to share your voice confidentially about your school working conditions and how you feel at your school. Add your voice now at the link in our bio.\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/467893897_448045604690625_1006382739295243085_n.jpg?_nc_cat=102\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=DR5rhW7Lk00Q7kNvgEGOTur\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYBSkg7LPq5wArx4s328KBtbi5YlrUXBRl9Z-8BK0inCkA\u0026oe=67555F59\",\"permalink\":\"https://www.instagram.com/p/DCr1-BQxH8Y/\",\"timestamp\":\"2024-11-22T19:16:27+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"17877435327193018\",\"caption\":\"#NewsAlert: Nevada Graduation Rate Increases for Class of 2024. Read more at the link in bio.\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/467909492_580762337775611_7881626938116159135_n.jpg?_nc_cat=110\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=jzyuSLuH8jIQ7kNvgGr4tKj\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYDeNqMwyyKdimX33dlYqy6wHZXuMMmGX-yOSDZ9wK40Gg\u0026oe=67554B9D\",\"permalink\":\"https://www.instagram.com/p/DCpLao2zFwf/\",\"timestamp\":\"2024-11-21T18:26:09+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18010258544662848\",\"caption\":\"#NewsAlert: Winners Announced for 2025 Nevada Reading Week Student Art Contest. Read more at the link in our bio.\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/467296165_1649854355744601_8096167502008418782_n.jpg?_nc_cat=110\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=OTS4z3FupKsQ7kNvgFi7toC\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYBGH-Csd_T_oQ1XD0-F_wkOTDbLrxc7dea6vijllrhbbA\u0026oe=67556B45\",\"permalink\":\"https://www.instagram.com/p/DCkwFLyodvX/\",\"timestamp\":\"2024-11-20T01:10:21+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18097942951472153\",\"caption\":\"? Calling all Nevada students in grades 3-12! ? The 2025 EngineerGirl Writing Contest is here, and this year’s challenge is to “Make an Object Smart!” ?? Imagine taking an everyday object and engineering it to be “smart.\\\" Tell us what it would do, how it could help people, and even what might go wrong.\\n\\nThis is an exciting opportunity for students to show off their creativity and problem-solving skills while practicing writing - a crucial skill in engineering. Engineers need strong communication skills to share their ideas, explain complex concepts, and collaborate on solutions. This contest ties perfectly with Nevada's Portrait of a Learner, encouraging students to think critically and empathetically about the world around them. ??\\n\\nSubmit your entry by Feb. 1, 2025. Get started at the link in our bio. \\n\\n#EngineerGirl #STEMWriting #NevadaPortraitOfALearner #FutureEngineers #STEM #NVSTEM #STEAM #NVSTEAM #NationalAcademyofEngineering\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/466878918_943632801155287_6927155394225509336_n.jpg?_nc_cat=102\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=mnE5UQyArPUQ7kNvgEbRjn0\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYA6Op7u6PsRYnaxsgPI0TtDT5Y06PLI3cjkTvUCaVGFBw\u0026oe=67557BD0\",\"permalink\":\"https://www.instagram.com/p/DCVNL9IML6f/\",\"timestamp\":\"2024-11-14T00:16:48+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18099053788480392\",\"caption\":\"It’s #TeacherTuesday and today we’re celebrating Mrs. Nicole Hunt from Faiss Middle School. She’s a passionate and dedicated teacher who deeply cares about her students' success. Her enthusiasm for science sparks curiosity and excitement in her students.\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/466598308_587413343726506_3938335590859984140_n.jpg?_nc_cat=103\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=CFLM4ef4UpkQ7kNvgHe16Cp\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYDXDPmUFpOMYiEDhCYIaEHFzbHvlMqh4HuEq6Y07zy69w\u0026oe=6755481B\",\"permalink\":\"https://www.instagram.com/p/DCRwI6fNx7f/\",\"timestamp\":\"2024-11-12T16:05:15+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18027100055580687\",\"caption\":\"Happy Veterans Day! ? Today, we honor the brave men and women who have served our nation with unwavering dedication. Nevada Department of Education offices are closed today in observance of the #VeteransDay holiday. #ThankYouVeterans\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/466002040_1525419168093527_7954335146359871344_n.jpg?_nc_cat=105\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=apkgytddL-4Q7kNvgEaLVsa\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYDT1v8PK8L2VnvD1vQbH8OzwgjWljxaKnqhF4Bx1g9zXA\u0026oe=67554F4B\",\"permalink\":\"https://www.instagram.com/p/DCPLXZaRj7-/\",\"timestamp\":\"2024-11-11T16:05:27+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18031776194519230\",\"caption\":\"Celebrate National STEM Day! ? Research shows that early exposure to STEM is key to building lasting interest and success in science and technology. Engaging students in STEM from a young age — especially in PreK-5 — fosters curiosity, problem-solving, and perseverance. These are qualities highlighted in the Nevada Portrait of a Learner. ??\\n\\nBy embedding STEM concepts early, we’re helping Nevada students develop the skills they need to thrive as future innovators, leaders, and problem-solvers. Let’s keep empowering our young learners! ?✨ Visit the link in our bio for more information. \\n\\n#NationalSTEMDay #NevadaSTEM #K5STEM #STEMEducation #NevadaPortraitOfALearner #FutureReady #PreKSTEM #OSIT #StemDay\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/466423959_440592362087038_7951489389367070952_n.jpg?_nc_cat=104\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=gv3exv4OkJ4Q7kNvgHdJKTG\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYCuFlNAcTdRlrMsp_0iyV1B6pV-1fIw_y8JqVP2pQJWCw\u0026oe=67556B6C\",\"permalink\":\"https://www.instagram.com/p/DCHriy4N9c2/\",\"timestamp\":\"2024-11-08T18:12:42+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18062089462805847\",\"caption\":\"Nevada is celebrating National STEM Day! ? Today, we’re recognizing the educators and advocates who inspire STEM learning across our state — and nominations are now open for STEM Teacher of the Year and STEM Advocate of the Year. ??\\n\\nDo you know an outstanding STEM teacher or advocate who goes above and beyond to ignite curiosity and innovation in Nevada’s students? Nominate them today to recognize their incredible impact! ?✨\\n\\nLearn more and submit your nomination at the link in our bio. @NVSTEMHub\\n#NationalSTEMDay #NevadaSTEM #STEMTeacherOfTheYear #STEMAdvocateOfTheYear #FutureReady #NevadaPortraitOfALearner #OSIT #StemDay\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/466130371_1230282974862487_974517676157306795_n.jpg?_nc_cat=106\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=2xi6oavzqDMQ7kNvgFeR1uP\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYA5I_JTh86bDJFeGlI5HmPXBUdBFJ9jEaRMOytZvNFofg\u0026oe=675579BA\",\"permalink\":\"https://www.instagram.com/p/DCHqlFjN89p/\",\"timestamp\":\"2024-11-08T18:04:16+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18027642428525899\",\"caption\":\"? Happy National STEM Day, Nevada! ? Today, we’re celebrating our Governor Designated STEM Schools across the state, where Nevada students are diving into hands-on projects, exploring innovative labs, and developing skills in science, technology, engineering, and math. ??? \\n\\n? Thanks to our inspiring educators who create dynamic learning environments that empower students to lead, problem-solve, and think critically every day. Discover more about our amazing STEM schools and their impact at the link in our bio. @NVSTEMHub \\n\\n#NationalSTEMDay #NevadaSTEM #STEMEducation #FutureReady #ThankYouEducators #STEMForAll #OSIT #NVPortraitofaLearner #StemDay\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/465947597_1056251939533637_4241085492569868320_n.jpg?_nc_cat=104\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=MFrPZlTm4EEQ7kNvgFbshva\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYAHbaY1151LmFH0OnnNQQ8Z4w0RbU0b-Nz1autpir0NhQ\u0026oe=67556466\",\"permalink\":\"https://www.instagram.com/p/DCHfRfIR3-w/\",\"timestamp\":\"2024-11-08T16:25:29+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"17980438202774798\",\"caption\":\"K-12 students are invited to enter the 60th Anniversary of the 1964 Civil Rights Act Art Contest. All mediums are accepted - including drawing, painting, music, dance, spoken word, and essays – and submissions are due Jan. 20, 2025. Visit the link in our bio for submission guidelines.\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/465808587_1729402091235069_8020391254631306390_n.jpg?_nc_cat=109\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=WxGhGTHMEckQ7kNvgFMvf03\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYA0Llfa7KzGPlzkjBT5URHZsraU4jlAogHpIOwK63CavA\u0026oe=675562E3\",\"permalink\":\"https://www.instagram.com/p/DCFMSZ1vgAL/\",\"timestamp\":\"2024-11-07T19:01:06+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18036213761464739\",\"caption\":\"? Know an inspiring young woman in grades 9-12 passionate about technology and computing? Nominate her for the NCWIT Aspirations in Computing (AiC) High School Award! ?? This award honors young women for their achievements and leadership in tech, encouraging them to keep pursuing their passions.\\n\\nAward categories include winner, honorable mention, and rising star, with recognitions at both the national and regional levels across the U.S. and territories. ? Hosted by NCWIT Alliance members, this award is a unique opportunity to celebrate future leaders in computing.\\n\\nNominate a deserving student today and help us spotlight the next generation of tech innovators at the link in our bio. \\n#NCWITAiC #WomenInTech #TechLeaders #AspirationsInComputing\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/465820314_1332634134715090_3034976206052779213_n.jpg?_nc_cat=101\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=eL3jMPcyxOYQ7kNvgEnJonL\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYDV9tNFX6r2O9SIMm2S2z4BauBEuZHTGC17vX2n67w5Sw\u0026oe=67555B6F\",\"permalink\":\"https://www.instagram.com/p/DCDDiNUMJFH/\",\"timestamp\":\"2024-11-06T23:06:07+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18036478622245922\",\"caption\":\"? Huge shoutout to Douglas County School District’s amazing Tara Auld and her middle schoolers for an inspiring Project-Based Learning (PBL) journey! ?? When they noticed teens and pre-teens weren’t visiting local museums ?️, they took action, launching a project to help connect their community with its rich history and culture. This PBL project is a perfect example of the Nevada Portrait of a Learner in action—building curious, collaborative problem-solvers who are committed to their communities. ?✨\\n\\n?️ Tara was also featured on the *We Can Do EPIC Things* podcast (episode 48) where she shared how PBL is empowering her students to make real change. ? Don’t miss this episode for an inspiring look at how Nevada educators are shaping the next generation. ? Visit the link in our bio to listen to the podcast.\\n\\n#NevadaPBL #NevadaLearner #CommunityImpact #DouglasCountySD #PBLLeadershipCohort #WeCanDoEpicThings #FutureReady #GoldStandardPBL #NevadaPortraitofaLearner\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/465861364_1603213123609726_5553185071951621672_n.jpg?_nc_cat=110\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=5n8A9YeuKh4Q7kNvgERfNI1\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYCel2u6lpV3KhP6AdkKQ67eHjmvyyeNDGshB8B97CWJrg\u0026oe=67557467\",\"permalink\":\"https://www.instagram.com/p/DCAn6CiM6IU/\",\"timestamp\":\"2024-11-06T00:26:31+0000\",\"media_type\":\"CAROUSEL_ALBUM\"},{\"id\":\"18466590433051111\",\"caption\":\"Join schoolhouse's small-group SAT bootcamps, college admissions workshops, and math learning labs or get extra homework help – all alongside a global community of students like you. Create a free account at the link in our bio.\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/465900882_876771857943032_2407488193545171026_n.jpg?_nc_cat=103\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=lRSUxH7s-YYQ7kNvgENe5tH\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYBAXexEWKK8s1rfTGRaChShJ5J4W4x5-nVvHzfea6CQwg\u0026oe=6755780C\",\"permalink\":\"https://www.instagram.com/p/DCAYf6LzPWR/\",\"timestamp\":\"2024-11-05T22:11:36+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"17895522648011951\",\"caption\":\"It's #TeacherTuesday! Today, we celebrate Mrs. Edie Guerra from Gunderson Middle School. She has been an educator for 21 years, and loves mentoring new teachers and those new to science. Her passion lies in empowering educators to recognize the positive impact they make.\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/465803568_1153177432712592_6091740432675521205_n.jpg?_nc_cat=109\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=n8aO3W8yynoQ7kNvgHkPE0w\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYB06HaiA4_AJIuwgt1_R5V9JRteu-a2qYwhwq0nBPZHSw\u0026oe=6755742B\",\"permalink\":\"https://www.instagram.com/p/DCAFyv_v_U8/\",\"timestamp\":\"2024-11-05T19:28:09+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18029906156126899\",\"caption\":\"The Nevada State Board of Education will meet at 2 p.m. Wednesday, Nov. 6. The meeting is open to the public, in-person or virtually. For the agenda and livestream information, please visit the link in our bio.\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/465621891_926965799288334_6654205945963175638_n.jpg?_nc_cat=109\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=jilY5sfyu-0Q7kNvgEg_xvq\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYDlOJAzWrj06ofIBn27tJ9biJSmmtf0n0QiYkFEWF1Xgg\u0026oe=67554D36\",\"permalink\":\"https://www.instagram.com/p/DB92o81Nh1-/\",\"timestamp\":\"2024-11-04T22:37:14+0000\",\"media_type\":\"IMAGE\"},{\"id\":\"18060112816799925\",\"caption\":\"? A big shout-out to John F. Miller School in Clark County for hosting an incredible Sensory Fair! Special thanks to Learning Strategist Elysia Byrd for inviting the Nevada Department of Education to share in this amazing event, and to teacher Joey Gaglione for creating an accessible, custom Plinko board—brilliantly engineered for all students to enjoy. ?️ @clarkcountysch \\n\\nThe love for learning and the school’s inclusive culture shone brightly, with clear STEM learning woven into every part of the event. They even had live animals to pet, adding an extra special touch to the day.?? We’re proud to celebrate schools that foster creativity and accessibility in education. #STEMeducation #SensoryFair #AllChildrenCanLearn #InclusiveLearning #NDE #STEMforAll #LearningforAll #Joy #PortraitofaNVLearner\",\"username\":\"nvstateed\",\"media_url\":\"https://scontent-sjc3-1.cdninstagram.com/v/t51.2885-15/465296505_1013455917208373_5687324029285185399_n.jpg?_nc_cat=105\u0026ccb=1-7\u0026_nc_sid=18de74\u0026_nc_ohc=gvPtyLrE1hwQ7kNvgGwtj_x\u0026_nc_zt=23\u0026_nc_ht=scontent-sjc3-1.cdninstagram.com\u0026edm=ANo9K5cEAAAA\u0026oh=00_AYAaAQEGC1y0Xkk9th6-zHP0dthbrnpfSZaC6G_IRPQIBw\u0026oe=67554F66\",\"permalink\":\"https://www.instagram.com/p/DB2Ix6ntT6E/\",\"timestamp\":\"2024-11-01T22:42:06+0000\",\"media_type\":\"CAROUSEL_ALBUM\"}]}}},\"dispalyInsta\":false,\"displayYoutubeTwitter\":true}]]}]]}]\n"])</script></body></html>