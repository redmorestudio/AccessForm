{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiKeys": {
    "PassportPdf": "YOUR_PASSPORTPDF_KEY_HERE",
    "Anthropic": "YOUR_ANTHROPIC_KEY_HERE"
  },
  "AsposePdfCloud": {
    "AppSid": "YOUR_ASPOSE_APP_SID_HERE",
    "AppKey": "YOUR_ASPOSE_APP_KEY_HERE"
  },
  "AiServices": {
    "LlamaGroq": {
      "Enabled": true,
      "ApiKey": "YOUR_GROQ_API_KEY_HERE",
      "Model": "openai/gpt-oss-120b",
      "BaseUrl": "https://api.groq.com/openai/v1",
      "MaxTokens": 4096,
      "Temperature": 0.3
    },
    "OpenAI": {
      "Enabled": true,
      "ApiKey": "YOUR_OPENAI_API_KEY_HERE",
      "Model": "gpt-5",
      "BaseUrl": "https://api.openai.com/v1",
      "MaxTokens": 8192,
      "Temperature": 0.0
    }
  },
  "FieldDetection": {
    "MultiStageValidation": {
      "Enabled": false,
      "UseClaudeValidation": false,
      "UseOpenAIValidation": false,
      "ConfidenceThresholds": {
        "AddMissingField": 0.95,
        "RemoveSpuriousField": 0.9,
        "CorrectLabel": 0.9
      },
      "ProcessingMode": "per-page"
    }
  },
  "VeraPdf": {
    "ExecutablePath": "/path/to/verapdf/verapdf",
    "JavaHome": "/path/to/jdk/Contents/Home",
    "WorkingDirectory": "/tmp/verapdf-work"
  }
}
