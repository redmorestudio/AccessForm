                        var resultObj = JsonSerializer.Deserialize<JsonElement>(result);
                        await JSRuntime.InvokeVoidAsync("console.log", "Parsed result object");
                        
                        if (resultObj.TryGetProperty("debugId", out JsonElement debugIdElement))
                        {
                            lastDebugId = debugIdElement.GetString();
                            await JSRuntime.InvokeVoidAsync("console.log", $"Found and stored debug ID: {lastDebugId}");
                        }
                        else
                        {
                            await JSRuntime.InvokeVoidAsync("console.log", "No debugId property found in response");
                            // Try to find it in nested structure
                            foreach (var prop in resultObj.EnumerateObject())
                            {
                                await JSRuntime.InvokeVoidAsync("console.log", $"Property: {prop.Name}");
                            }
                        }
                    }
                    catch (Exception parseEx) 
                    { 
                        await JSRuntime.InvokeVoidAsync("console.error", $"Error parsing for debugId: {parseEx.Message}");
                    }
                    
                    await JSRuntime.InvokeVoidAsync("console.log", "ProcessFile: Got result from JavaScript fetch");
                    await ProcessApiResponse(result, IsWordFile(droppedFileData.Name));
                }
                else
