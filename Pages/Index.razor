    private TagModificationModal tagEditorModal;
    private bool showTagEditor = false;
    private string currentTagTreeJson = "";
    private List<TagModificationModal.EditableField> currentFields = new();
    
    private async Task OpenTagEditor()
    {
        try
        {
            // Get the current tag structure
            if (processingResults?.AccessibleFileData != null)
            {
                // Call the API to extract tag structure
                var requestData = new { pdfData = processingResults.AccessibleFileData };
                var requestContent = new StringContent(
                    JsonSerializer.Serialize(requestData),
                    System.Text.Encoding.UTF8,
                    "application/json"
                );
                
                var http = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
                var response = await http.PostAsync("/api/extract-tag-structure", requestContent);
                
                if (response.IsSuccessStatusCode)
                {
                    currentTagTreeJson = await response.Content.ReadAsStringAsync();
                    var tagStructure = JsonDocument.Parse(currentTagTreeJson);
                    
                    // Use the fields from PdfPreservationService that were stored in sessionStorage
                    // These have the correct types, sizes and positions from Syncfusion
                    currentFields.Clear();

                    // Get the correctly detected fields from session storage
                    var sessionFieldsJson = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "tempDetectedFields");
                    if (!string.IsNullOrEmpty(sessionFieldsJson))
                    {
                        await JSRuntime.InvokeVoidAsync("console.log", $"Using fields from PdfPreservationService via session storage...");
                        var sessionFields = JsonSerializer.Deserialize<List<TagModificationModal.EditableField>>(sessionFieldsJson);
                        foreach (var sessionField in sessionFields)
                        {
                            currentFields.Add(new TagModificationModal.EditableField
                            {
                                Name = sessionField.Name,
                                OriginalName = sessionField.OriginalName,
                                Type = sessionField.Type,
                                Tooltip = sessionField.Tooltip,
                                IsRequired = sessionField.IsRequired,
                                Page = sessionField.Page,
                                X = sessionField.X,
                                Y = sessionField.Y,
                                Width = sessionField.Width,
                                Height = sessionField.Height,
                                PageWidth = sessionField.PageWidth,
                                PageHeight = sessionField.PageHeight,
                                OriginalIndex = sessionField.OriginalIndex
                            });
                        }
                        await JSRuntime.InvokeVoidAsync("console.log", $"Loaded {currentFields.Count} fields from PdfPreservationService");
                    }
                    else
                    {
                        await JSRuntime.InvokeVoidAsync("console.log", "WARNING: No detected fields found in session storage - field positions may be incorrect!");

                        // Fallback to tag structure fields (with broken Y-coordinates) if no detected fields available
                        if (tagStructure.RootElement.TryGetProperty("formFields", out var fields))
                        {
                            foreach (var field in fields.EnumerateArray())
                            {
                                currentFields.Add(new TagModificationModal.EditableField
                                {
                                    Name = field.GetProperty("name").GetString(),
                                    Type = field.GetProperty("type").GetString(),
                                    Tooltip = field.TryGetProperty("tooltip", out var tooltip) ? tooltip.GetString() : "",
                                    Page = field.TryGetProperty("page", out var page) ? page.GetInt32() : 1,
                                    X = field.TryGetProperty("x", out var x) ? (float)x.GetDouble() : 100,
                                    Y = field.TryGetProperty("y", out var y) ? (float)y.GetDouble() : 100,
                                    Width = field.TryGetProperty("width", out var width) ? (float)width.GetDouble() : 150,
                                    Height = field.TryGetProperty("height", out var height) ? (float)height.GetDouble() : 20
                                });
                            }
                            await JSRuntime.InvokeVoidAsync("console.log", "WARNING: Using tag structure fields with potentially incorrect Y-coordinates");
                        }
                    }

                    showTagEditor = true;
                    StateHasChanged();
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", "No tag structure available. Process the document first.");
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "No document available. Process a document first.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error opening tag editor: {ex.Message}");
        }
    }
    
    private async Task HandleTagEditorApply(List<TagModificationModal.EditableField> updatedFields)
    {
        try
        {
            isProcessing = true;
            processingMessage = "Applying field changes to PDF...";
            StateHasChanged();
            
            if (processingResults != null && !string.IsNullOrEmpty(processingResults.AccessibleFileData))
            {
                // Convert base64 PDF to bytes
                var pdfBytes = Convert.FromBase64String(processingResults.AccessibleFileData);
                
                // Create form data with updated fields
                using var httpClient = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
                var formData = new MultipartFormDataContent();
                formData.Add(new ByteArrayContent(pdfBytes), "pdf", "current.pdf");
                
                // Convert updated fields to the format expected by the API
                // We need to map from the current field names to the new names
                // NOW INCLUDING PAGE NUMBERS to fix pagination issues
                var fieldUpdates = updatedFields.Select(f => new
                {
                    OriginalName = f.OriginalName ?? f.Name, // Use OriginalName if available, otherwise current Name
                    NewName = f.Name,
                    FieldType = f.Type,
                    Tooltip = f.Tooltip,
                    IsRequired = f.IsRequired,
                    PageNumber = f.Page, // CRITICAL: Include page number to fix pagination
                    // Include coordinates so they can be updated if page changes
                    X = f.X,
                    Y = f.Y,
                    Width = f.Width,
                    Height = f.Height
                }).ToList();

                // INSTRUMENTATION: Write to dedicated debug file
                var debugPath = "/tmp/coordinate_debug.log";
                var debugLines = new List<string>();
                debugLines.Add("═══════════════════════════════════════════════════════════");
                debugLines.Add($"🟢 [TAG EDITOR → API] SENDING {fieldUpdates.Count} FIELDS TO /api/update-pdf-fields-v4");
                debugLines.Add($"Timestamp: {DateTime.Now:yyyy-MM-dd HH:mm:ss.fff}");
                debugLines.Add("═══════════════════════════════════════════════════════════");
                var i = 0;
                foreach (var f in fieldUpdates.Take(10))
                {
                    i++;
                    debugLines.Add($"🟢 [{i}] '{f.OriginalName}' → '{f.NewName}':");
                    debugLines.Add($"    Type={f.FieldType}, Page={f.PageNumber}");
                    debugLines.Add($"    X={f.X:F1}, Y={f.Y:F1}, W={f.Width:F1}x{f.Height:F1}");
                }
                if (fieldUpdates.Count > 10)
                {
                    debugLines.Add($"🟢 ... and {fieldUpdates.Count - 10} more fields");
                }
                debugLines.Add("═══════════════════════════════════════════════════════════");
                debugLines.Add("");

                System.IO.File.AppendAllLines(debugPath, debugLines);

                var fieldsJson = System.Text.Json.JsonSerializer.Serialize(fieldUpdates);
                formData.Add(new StringContent(fieldsJson), "fields");  // V2 expects "fields" parameter
                
                // Call the V2 API that just updates fields without destroying PDF content
                var response = await httpClient.PostAsync("/api/update-pdf-fields-v2", formData);
                
                if (response.IsSuccessStatusCode)
                {
                    var resultJson = await response.Content.ReadAsStringAsync();
                    var result = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(resultJson);
                    
                    // V2 endpoint returns "pdf" instead of "pdfData"
                    if (result != null && (result.ContainsKey("pdf") || result.ContainsKey("pdfData")))
                    {
                        // Update the accessible PDF with the new one
                        var updatedPdfData = result.ContainsKey("pdf") ? result["pdf"].ToString() : result["pdfData"].ToString();
                        processingResults.AccessibleFileData = updatedPdfData;
                        
                        // CRITICAL FIX: Replace currentFields with updatedFields to handle deletions
                        // The updatedFields list from the modal already has deleted fields removed
                        // We just need to apply any server corrections to the updated list
                        currentFields = updatedFields;

                        // Check if we have corrected field data from the server
                        if (result.ContainsKey("correctedFields"))
                        {
                            // Use the corrected dimensions from the server
                            var correctedFieldsElement = (System.Text.Json.JsonElement)result["correctedFields"];
                            var correctedFields = correctedFieldsElement.EnumerateArray().ToList();

                            foreach (var correctedField in correctedFields)
                            {
                                var originalName = correctedField.GetProperty("originalName").GetString();
                                var fieldToUpdate = currentFields.FirstOrDefault(f => f.Name == originalName);
                                if (fieldToUpdate != null)
                                {
                                    fieldToUpdate.Name = correctedField.GetProperty("name").GetString();
                                    fieldToUpdate.Type = correctedField.GetProperty("type").GetString();
                                    fieldToUpdate.Tooltip = correctedField.TryGetProperty("tooltip", out var tooltip) ? tooltip.GetString() : "";

                                    // Only update positions if they're not null
                                    if (correctedField.TryGetProperty("x", out var x) && x.ValueKind != System.Text.Json.JsonValueKind.Null)
                                        fieldToUpdate.X = (float)x.GetDouble();
                                    if (correctedField.TryGetProperty("y", out var y) && y.ValueKind != System.Text.Json.JsonValueKind.Null)
                                        fieldToUpdate.Y = (float)y.GetDouble();
                                    if (correctedField.TryGetProperty("width", out var width) && width.ValueKind != System.Text.Json.JsonValueKind.Null)
                                        fieldToUpdate.Width = (float)width.GetDouble();
                                    if (correctedField.TryGetProperty("height", out var height) && height.ValueKind != System.Text.Json.JsonValueKind.Null)
                                        fieldToUpdate.Height = (float)height.GetDouble();
                                    // Update OriginalName for future edits
                                    fieldToUpdate.OriginalName = fieldToUpdate.Name;
                                }
                            }
                        }
                        else
                        {
                            // Fallback: Apply checkbox dimension correction if server doesn't send corrected fields
                            foreach (var field in currentFields)
                            {
                                if ((field.Type?.ToLower() == "checkbox" || field.Type?.ToLower() == "radio")
                                    && field.Width > field.Height * 2)
                                {
                                    // Correct checkbox dimensions to be square
                                    field.Width = Math.Min(field.Height, 20);
                                    field.Height = Math.Min(field.Height, 20);
                                }
                                // Update OriginalName for future edits
                                field.OriginalName = field.Name;
                            }
                        }

                        // PDF updated in memory - user can download manually using "Download Accessible PDF" button
                        // (Auto-download removed to allow continuous editing)

                        // Refresh the preview
                        StateHasChanged();
                    }
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    await JSRuntime.InvokeVoidAsync("alert", $"Error updating PDF: {error}");
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "No PDF available to update. Please process a document first.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error applying field changes: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            // Keep editor open to allow continuous editing - user can close manually when done
            StateHasChanged();
        }
    }
    
}

<TagModificationModal @ref="tagEditorModal" 
                      IsVisible="showTagEditor" 
                      IsVisibleChanged="@((bool value) => { showTagEditor = value; StateHasChanged(); })"
                      TagTreeJson="@currentTagTreeJson"
                      Fields="@currentFields"
                      OnApplyChanges="HandleTagEditorApply"
                      PdfBytes="@(processingResults?.AccessibleFileData != null ? Convert.FromBase64String(processingResults.AccessibleFileData) : null)" />

