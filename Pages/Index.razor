            await JSRuntime.InvokeVoidAsync("eval", @"
                // Use Bootstrap 5 Modal API
                const modalElement = document.getElementById('tagTreeModal');
                const modal = new bootstrap.Modal(modalElement);
                modal.show();
                document.getElementById('tagTreeModalBody').innerHTML = `
                    <div class='text-center p-5'>
                        <div class='spinner-border text-primary' role='status'>
                            <span class='visually-hidden'>Loading tag structure...</span>
                        </div>
                        <p class='mt-3'>Analyzing PDF structure...</p>
                    </div>
                `;
            ");
            
            // Call the API to extract tag structure
            using var http = new HttpClient();
            http.BaseAddress = new Uri(NavigationManager.BaseUri);
            
            var requestContent = new StringContent(
                JsonSerializer.Serialize(new { pdfData = base64Data }),
                System.Text.Encoding.UTF8,
                "application/json"
            );
            
            var response = await http.PostAsync("/api/extract-tag-structure", requestContent);
            var jsonResponse = await response.Content.ReadAsStringAsync();
            
            // Log raw response
            await JSRuntime.InvokeVoidAsync("console.log", "Raw tag response:", jsonResponse);
            
            JsonElement tagData;
            try 
            {
                tagData = JsonSerializer.Deserialize<JsonElement>(jsonResponse);
            }
            catch (JsonException jex)
            {
                await JSRuntime.InvokeVoidAsync("console.error", "Failed to parse JSON:", jex.Message, "Response was:", jsonResponse);
                throw new Exception($"Invalid JSON response: {jex.Message}");
            }
            
            currentTagTreeData = tagData;
            currentTagTreeFileName = fileName;
            
            // Log the response for debugging
            await JSRuntime.InvokeVoidAsync("console.log", "Tag tree response:", jsonResponse);
            
            // Render the tag tree in the modal
            if (tagData.TryGetProperty("success", out var successProp) && successProp.GetBoolean())
            {
                await RenderTagTree(tagData);
            }
            else
            {
                var error = tagData.TryGetProperty("error", out var errorProp) 
                    ? errorProp.GetString() 
                    : "Failed to extract tag structure";
                    
                await JSRuntime.InvokeVoidAsync("eval", $@"
                    document.getElementById('tagTreeModalBody').innerHTML = `
                        <div class='alert alert-warning'>
                            <h6>Unable to Extract Tag Structure</h6>
                            <p>{error}</p>
                            <p class='mb-0'><small>This usually means the PDF doesn't have accessibility tags. Try processing it through the accessibility converter first.</small></p>
                        </div>
                    `;
                ");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", "Error viewing tag tree:", ex.Message);
            await JSRuntime.InvokeVoidAsync("eval", $@"
                document.getElementById('tagTreeModalBody').innerHTML = `
                    <div class='alert alert-danger'>
                        <h6>Error Loading Tag Structure</h6>
                        <p>{ex.Message}</p>
                    </div>
                `;
            ");
        }
    }
    
    private async Task RenderTagTree(JsonElement tagData)
    {
        try
        {
            // Check what properties actually exist
            // Try to get structure from either 'structure' or 'tagTree' property
            var hasStructure = tagData.TryGetProperty("structure", out var structure);
            if (!hasStructure)
            {
                hasStructure = tagData.TryGetProperty("tagTree", out structure);
            }
            var hasMetadata = tagData.TryGetProperty("metadata", out var metadata);
            
            // Check if we have form fields to display even if no structure
            var hasFormFields = tagData.TryGetProperty("formFields", out var formFields) && 
                               formFields.ValueKind == JsonValueKind.Array && 
                               formFields.GetArrayLength() > 0;
            
            if (!hasStructure && !hasFormFields)
            {
                await JSRuntime.InvokeVoidAsync("console.error", "No structure or formFields in response");
                await JSRuntime.InvokeVoidAsync("eval", @"
                    document.getElementById('tagTreeModalBody').innerHTML = `<div class='alert alert-warning'>No structure data available</div>`;
                ");
                return;
            }
            
            var html = "<div class='row'>";
            
            // Left side - Tree structure
            html += "<div class='col-md-8'>";
            html += "<h6>Document Structure</h6>";
            html += "<div class='tree-view'>";
            
            // Check if structure is an object with properties or an array
            if (hasStructure && structure.ValueKind == JsonValueKind.Object)
            {
                // Check if the structure has actual children
                var hasChildren = false;
                if (structure.TryGetProperty("children", out var children) && 
                    children.ValueKind == JsonValueKind.Array && 
                    children.GetArrayLength() > 0)
                {
                    hasChildren = true;
                }
                
                // Only render tree if it has content
                if (hasChildren)
                {
                    html += RenderTreeNode(structure);
                }
                else
                {
                    html += "<p class='text-muted'>Document structure is empty</p>";
                }
            }
            else if (hasStructure && structure.ValueKind == JsonValueKind.Array)
            {
                // Render each item in the structure array
                foreach (var item in structure.EnumerateArray())
                {
                    html += RenderTreeNode(item);
                }
            }
            
            // Always show form fields if they exist
            if (hasFormFields)
            {
                html += "<h6 class='mt-3'>Form Fields</h6>";
                html += "<div style='max-height: 400px; overflow-y: auto;'>";
                html += "<table class='table table-sm table-striped'>";
                html += "<thead><tr><th>Field Name</th><th>Type</th><th>Tooltip</th><th>Page</th></tr></thead>";
                html += "<tbody>";
                foreach (var field in formFields.EnumerateArray())
                {
                    if (field.TryGetProperty("name", out var name) && field.TryGetProperty("type", out var type))
                    {
                        var page = field.TryGetProperty("page", out var p) ? p.GetInt32() : 1;
                        var tooltip = field.TryGetProperty("tooltip", out var t) ? t.GetString() : "";
                        var fieldType = type.GetString();
                        var typeClass = fieldType.Contains("radio") ? "text-warning" : 
                                       fieldType.Contains("checkbox") ? "text-success" : 
                                       fieldType.Contains("signature") ? "text-danger" :
                                       fieldType.Contains("date") ? "text-info" : "text-primary";
                        var tooltipDisplay = string.IsNullOrEmpty(tooltip) ? "<em class='text-muted'>No tooltip</em>" : tooltip;
                        html += $"<tr><td><strong>{name.GetString()}</strong></td><td class='{typeClass}'>{fieldType}</td><td>{tooltipDisplay}</td><td>{page}</td></tr>";
                    }
                }
                html += "</tbody></table>";
                html += "</div>";
            }
            
            html += "</div>";
            html += "</div>";
            
            // Right side - Statistics
            html += "<div class='col-md-4'>";
            html += "<h6>Statistics</h6>";
            html += "<dl class='row'>";
            
            if (hasMetadata)
            {
                if (metadata.TryGetProperty("pageCount", out var pageCount))
                    html += $"<dt class='col-sm-7'>Total Pages:</dt><dd class='col-sm-5'>{pageCount.GetInt32()}</dd>";
                
                if (metadata.TryGetProperty("fieldCount", out var fieldCount))
                    html += $"<dt class='col-sm-7'>Form Fields:</dt><dd class='col-sm-5'>{fieldCount.GetInt32()}</dd>";
                
                if (metadata.TryGetProperty("hasForm", out var hasForm))
                    html += $"<dt class='col-sm-7'>Has Form:</dt><dd class='col-sm-5'>{(hasForm.GetBoolean() ? "Yes" : "No")}</dd>";
            }
            
            html += "</dl>";
            html += "</div>";
            html += "</div>";
            
            // Apply the HTML to the modal
            // Apply the HTML to the modal
            var escapedHtml = html.Replace("`", "\\`");
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('tagTreeModalBody').innerHTML = `{escapedHtml}`;");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", "Error rendering tag tree:", ex.Message);
            throw;
        }
    }
    
    
    private string RenderTreeNode(JsonElement node, int level = 0)
    {
        var html = "";
        var indent = new string(' ', level * 4);
        
        var type = node.TryGetProperty("type", out var typeProp) ? typeProp.GetString() : "Unknown";
        var content = node.TryGetProperty("content", out var contentProp) ? contentProp.GetString() : "";
        var tooltip = node.TryGetProperty("tooltip", out var tooltipProp) ? tooltipProp.GetString() : "";
        
        html += $"<div class='tree-node' style='margin-left: {level * 20}px;'>";
        html += $"<span class='node-type badge bg-secondary me-2'>{type}</span>";
        html += $"<span class='node-content'>{content}</span>";
        
        if (!string.IsNullOrEmpty(tooltip))
        {
            html += $" <small class='text-muted'>({tooltip})</small>";
        }
        
        html += "</div>";
        
        // Render children if present
        if (node.TryGetProperty("children", out var children))
        {
            foreach (var child in children.EnumerateArray())
            {
                html += RenderTreeNode(child, level + 1);
            }
        }
        
        return html;
    }
    
