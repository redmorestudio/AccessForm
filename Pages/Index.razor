    private void StartProcessingTimer()
    {
        processingSeconds = 0;
        processingTime = "0:00";
        processingStartTime = DateTime.Now;
        
        processingTimer?.Dispose();
        processingTimer = new System.Timers.Timer(1000); // Update every second
        processingTimer.Elapsed += async (sender, e) =>
        {
            processingSeconds++;
            var minutes = processingSeconds / 60;
            var seconds = processingSeconds % 60;
            processingTime = $"{minutes}:{seconds:D2}";
            
            await InvokeAsync(StateHasChanged);
        };
        processingTimer.Start();
    }
    
