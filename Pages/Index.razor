            processingMessage = "";
            StopProcessingTimer();
        }
    }
    
    private async Task ProcessApiResponse(string json, bool isWordSource)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("console.log", $"ProcessApiResponse: Parsing JSON, isWordSource={isWordSource}");
            await JSRuntime.InvokeVoidAsync("console.log", $"ProcessApiResponse: First 500 chars of response: {json.Substring(0, Math.Min(500, json.Length))}");
            
            var result = System.Text.Json.JsonSerializer.Deserialize<JsonElement>(json);
            
            // Log available properties
            await JSRuntime.InvokeVoidAsync("console.log", "ProcessApiResponse: Available top-level properties:");
            foreach (var prop in result.EnumerateObject())
            {
                await JSRuntime.InvokeVoidAsync("console.log", $"  - {prop.Name}");
            }
            
            if (isWordSource)
            {
                // Word to PDF conversion result
                processingResults = new ProcessingResult
                {
                    IsWordSource = true,
                    NormalFileName = result.GetProperty("normalPdf").GetProperty("filename").GetString(),
                    NormalFileData = result.GetProperty("normalPdf").GetProperty("data").GetString(),
                    NormalFileSize = result.GetProperty("normalPdf").GetProperty("size").GetInt32(),
                    AccessibleFileName = result.GetProperty("accessiblePdf").GetProperty("filename").GetString(),
                    AccessibleFileData = result.GetProperty("accessiblePdf").GetProperty("data").GetString(),
                    AccessibleFileSize = result.GetProperty("accessiblePdf").GetProperty("size").GetInt32(),
                    ComplianceLevel = result.GetProperty("report").GetProperty("compliance").GetString(),
                    FieldsProcessed = result.GetProperty("report").GetProperty("fieldsProcessed").GetInt32(),
                    MeasuresApplied = result.GetProperty("report").GetProperty("measuresApplied").GetInt32(),
                    AiEnhanced = GetJsonBool(result.GetProperty("report"), "aiEnhanced", false),
                    AiProvider = GetJsonString(result.GetProperty("report"), "aiProvider", "None"),
                    AccessibilityScore = GetJsonInt(result.GetProperty("report"), "accessibilityScore", 0)
                };
                
                // Extract debug ID if present (for both Word and PDF sources)
                if (result.TryGetProperty("debugId", out JsonElement debugIdProp))
                {
                    lastDebugId = debugIdProp.GetString();
                    await JSRuntime.InvokeVoidAsync("console.log", $"ProcessApiResponse: Found debug ID: {lastDebugId}");
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("console.log", "ProcessApiResponse: No debugId in response");
                }

                // Parse detected fields if present (for Word documents with field detection)
                await JSRuntime.InvokeVoidAsync("console.log", "Checking for fields in response...");
                if (result.TryGetProperty("fields", out JsonElement fields) && fields.ValueKind == JsonValueKind.Array)
                {
                    var detectedFields = new List<TagModificationModal.EditableField>();

                    foreach (var field in fields.EnumerateArray())
                    {
                        var editableField = new TagModificationModal.EditableField
                        {
                            Name = field.GetProperty("name").GetString() ?? "Unknown",
                            OriginalName = field.GetProperty("name").GetString() ?? "Unknown",
                            Type = field.GetProperty("type").GetString() ?? "text",
                            X = (float)field.GetProperty("x").GetDouble(),
                            Y = (float)field.GetProperty("y").GetDouble(),
                            Width = (float)field.GetProperty("width").GetDouble(),
                            Height = (float)field.GetProperty("height").GetDouble(),
                            Page = field.GetProperty("page").GetInt32(),
                            PageWidth = field.TryGetProperty("pageWidth", out var pageWidthElement) ? (float)pageWidthElement.GetDouble() : 612f,
                            PageHeight = field.TryGetProperty("pageHeight", out var pageHeightElement) ? (float)pageHeightElement.GetDouble() : 792f,
                            Tooltip = field.TryGetProperty("tooltip", out var tooltipElement) ? tooltipElement.GetString() : "",
                            IsRequired = field.TryGetProperty("isRequired", out var requiredElement) && requiredElement.GetBoolean(),
                            OriginalIndex = detectedFields.Count + 1
                        };

                        detectedFields.Add(editableField);
                    }

                    await JSRuntime.InvokeVoidAsync("console.log", $"Parsed {detectedFields.Count} detected fields from response");

                    // CRITICAL: Store the fields for the field editor
                    if (detectedFields.Count > 0)
                    {
                        // Store fields and PDF data for the field editor
                        var fieldsJson = System.Text.Json.JsonSerializer.Serialize(detectedFields);
                        await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "tempDetectedFields", fieldsJson);
                        await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "tempPdfData", processingResults.AccessibleFileData);
                        await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "tempPdfFileName", processingResults.AccessibleFileName);

                        await JSRuntime.InvokeVoidAsync("console.log", "Stored detected fields in session storage for field editor");
                    }
                }

                // Parse tag structure if present
                await JSRuntime.InvokeVoidAsync("console.log", "Checking for tagStructure in response...");
                if (result.TryGetProperty("tagStructure", out JsonElement tagStructure))
                {
                    await JSRuntime.InvokeVoidAsync("console.log", "Found tagStructure:", tagStructure.GetRawText());
                    processingResults.TagTree = GetJsonString(tagStructure, "tagTree", "");
                    processingResults.TotalTagNodes = GetJsonInt(tagStructure, "totalNodes", 0);
                    
                    if (tagStructure.TryGetProperty("statistics", out JsonElement stats))
                    {
                        processingResults.TotalHeadings = GetJsonInt(stats, "totalHeadings", 0);
                        processingResults.TotalParagraphs = GetJsonInt(stats, "totalParagraphs", 0);
                        processingResults.TotalTables = GetJsonInt(stats, "totalTables", 0);
                        
                        if (stats.TryGetProperty("tagCounts", out JsonElement tagCounts))
                        {
                            foreach (var prop in tagCounts.EnumerateObject())
                            {
                                processingResults.TagCounts[prop.Name] = prop.Value.GetInt32();
                            }
                        }
                    }
                    
                    if (tagStructure.TryGetProperty("recommendations", out JsonElement recs))
                    {
                        foreach (var rec in recs.EnumerateArray())
                        {
                            processingResults.TagRecommendations.Add(rec.GetString());
                        }
                    }
                }
                
                await JSRuntime.InvokeVoidAsync("console.log", $"Word - Tag nodes: {processingResults.TotalTagNodes}, AI: {processingResults.AiEnhanced}");
            }
            else
            {
                // PDF remediation result - backend returns normalPdf/accessiblePdf for both Word and PDF
                processingResults = new ProcessingResult
                {
                    IsWordSource = false,
                    NormalFileName = result.GetProperty("normalPdf").GetProperty("filename").GetString(),
                    NormalFileData = result.GetProperty("normalPdf").GetProperty("data").GetString(),
                    NormalFileSize = result.GetProperty("normalPdf").GetProperty("size").GetInt32(),
                    AccessibleFileName = result.GetProperty("accessiblePdf").GetProperty("filename").GetString(),
                    AccessibleFileData = result.GetProperty("accessiblePdf").GetProperty("data").GetString(),
                    AccessibleFileSize = result.GetProperty("accessiblePdf").GetProperty("size").GetInt32(),
                    ComplianceLevel = result.GetProperty("report").GetProperty("compliance").GetString(),
                    FieldsProcessed = result.GetProperty("report").GetProperty("fieldsProcessed").GetInt32(),
                    MeasuresApplied = result.GetProperty("report").GetProperty("measuresApplied").GetInt32(),
                    AiEnhanced = GetJsonBool(result.GetProperty("report"), "aiEnhanced", false),
                    AiProvider = GetJsonString(result.GetProperty("report"), "aiProvider", "None"),
                    AccessibilityScore = GetJsonInt(result.GetProperty("report"), "accessibilityScore", 0)
                };
                
                // Parse tag structure if present (for PDF remediation)
                await JSRuntime.InvokeVoidAsync("console.log", "PDF: Checking for tagStructure in response...");
                if (result.TryGetProperty("tagStructure", out JsonElement tagStructurePdf))
                {
                    await JSRuntime.InvokeVoidAsync("console.log", "PDF: Found tagStructure:", tagStructurePdf.GetRawText());
                    processingResults.TagTree = GetJsonString(tagStructurePdf, "tagTree", "");
                    processingResults.TotalTagNodes = GetJsonInt(tagStructurePdf, "totalNodes", 0);
                    
                    if (tagStructurePdf.TryGetProperty("statistics", out JsonElement statsPdf))
                    {
                        processingResults.TotalHeadings = GetJsonInt(statsPdf, "totalHeadings", 0);
                        processingResults.TotalParagraphs = GetJsonInt(statsPdf, "totalParagraphs", 0);
                        processingResults.TotalTables = GetJsonInt(statsPdf, "totalTables", 0);
                        
                        if (statsPdf.TryGetProperty("tagCounts", out JsonElement tagCountsPdf))
                        {
                            foreach (var prop in tagCountsPdf.EnumerateObject())
                            {
                                processingResults.TagCounts[prop.Name] = prop.Value.GetInt32();
                            }
                        }
                    }
                    
                    if (tagStructurePdf.TryGetProperty("recommendations", out JsonElement recsPdf))
                    {
                        foreach (var rec in recsPdf.EnumerateArray())
                        {
                            processingResults.TagRecommendations.Add(rec.GetString());
                        }
                    }
                }
                
                await JSRuntime.InvokeVoidAsync("console.log", $"PDF - Tag nodes: {processingResults.TotalTagNodes}, AI: {processingResults.AiEnhanced}");
            }
            
            await JSRuntime.InvokeVoidAsync("console.log", "ProcessApiResponse: Successfully parsed response, clearing file selection");
            selectedFile = null; // Clear selection after successful processing
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"ProcessApiResponse: Error parsing response: {ex.Message}");
            throw new Exception($"Failed to parse server response: {ex.Message}", ex);
        }
    }
    
