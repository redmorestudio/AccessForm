@* VERSION: 2024-09-24-FIXED-PAGE-DETECTION *@
@page "/field-editor"
@using WordToPdfConverter.Models
@using System.Text.Json
@using System.Net.Http.Headers
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<h3>PDF Form Field Editor</h3>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @ErrorMessage
    </div>
}

<!-- File Upload Section -->
<div class="card mb-3">
    <div class="card-header">
        <h5>Load PDF for Editing</h5>
    </div>
    <div class="card-body">
        <div class="input-group">
            <input type="file" class="form-control" accept=".pdf" @ref="fileInput" />
            <button class="btn btn-primary" @onclick="LoadFieldsFromFile">Load Fields</button>
        </div>
        @if (!string.IsNullOrEmpty(CurrentFileName))
        {
            <small class="text-muted mt-2 d-block">Currently editing: @CurrentFileName</small>
        }
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <!-- Left Panel: Field Table Editor -->
        <div class="col-md-7">
            <div class="card">
                <div class="card-header">
                    <h5>Form Fields</h5>
                    <div class="btn-group" role="group">
                        <button class="btn btn-sm btn-primary" @onclick="AddField">
                            <i class="bi bi-plus"></i> Add Field
                        </button>
                        <button class="btn btn-sm btn-success" @onclick="SaveChanges" disabled="@(!HasChanges)">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                        <button class="btn btn-sm btn-info" @onclick="ExportFields">
                            <i class="bi bi-download"></i> Export JSON
                        </button>
                    </div>
                </div>
                <div class="card-body" style="max-height: 70vh; overflow-y: auto;">
                    @if (Fields != null && Fields.Any())
                    {
                        <table class="table table-sm table-hover">
                            <thead class="sticky-top bg-white">
                                <tr>
                                    <th width="5%">#</th>
                                    <th width="20%">Field Name</th>
                                    <th width="15%">Type</th>
                                    <th width="10%">Page</th>
                                    <th width="10%">X</th>
                                    <th width="10%">Y</th>
                                    <th width="10%">Width</th>
                                    <th width="10%">Height</th>
                                    <th width="5%">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var field in Fields)
                                {
                                    <tr class="@(field.IsSelected ? "table-primary" : "")" 
                                        @onclick="() => SelectField(field)">
                                        <td>@field.ShortId</td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" 
                                                   @bind="field.FieldName" @bind:event="oninput"
                                                   @onchange="() => MarkAsChanged(field)" />
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm" 
                                                    @bind="field.FieldType"
                                                    @bind:after="() => MarkAsChanged(field)">
                                                @foreach (var type in FieldTypes)
                                                {
                                                    <option value="@type">@type</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" 
                                                   @bind="field.PageNumber" @bind:event="oninput"
                                                   @onchange="() => MarkAsChanged(field)" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" 
                                                   @bind="field.X" @bind:event="oninput" step="0.5"
                                                   @onchange="() => MarkAsChanged(field)" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" 
                                                   @bind="field.Y" @bind:event="oninput" step="0.5"
                                                   @onchange="() => MarkAsChanged(field)" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" 
                                                   @bind="field.Width" @bind:event="oninput" step="0.5"
                                                   @onchange="() => MarkAsChanged(field)" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" 
                                                   @bind="field.Height" @bind:event="oninput" step="0.5"
                                                   @onchange="() => MarkAsChanged(field)" />
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-danger" 
                                                    @onclick="() => RemoveField(field)"
                                                    @onclick:stopPropagation="true">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No fields loaded. Upload a PDF to begin editing.
                        </div>
                    }
                </div>
            </div>
            
            <!-- Advanced Field Properties -->
            @if (SelectedField != null)
            {
                <div class="card mt-3">
                    <div class="card-header">
                        <h6>Advanced Properties: @SelectedField.FieldName</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label">Tooltip/Help Text</label>
                                <input type="text" class="form-control form-control-sm" 
                                       @bind="SelectedField.Tooltip" 
                                       @bind:after="() => MarkAsChanged(SelectedField)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Validation Pattern</label>
                                <input type="text" class="form-control form-control-sm" 
                                       @bind="SelectedField.ValidationPattern" 
                                       @bind:after="() => MarkAsChanged(SelectedField)"
                                       placeholder="e.g., ^\d{3}-\d{2}-\d{4}$ for SSN" />
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-4">
                                <label class="form-label">Source</label>
                                <input type="text" class="form-control form-control-sm"
                                       @bind="SelectedField.Source" readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Confidence</label>
                                <input type="number" class="form-control form-control-sm"
                                       @bind="SelectedField.Confidence" step="0.01" min="0" max="1" readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tab Index</label>
                                <input type="number" class="form-control form-control-sm"
                                       @bind="SelectedField.TabIndex"
                                       @bind:after="() => MarkAsChanged(SelectedField)" />
                            </div>
                        </div>
                        @if (SelectedField.FieldType == "radio")
                        {
                            <div class="row mt-2">
                                <div class="col-md-12">
                                    <label class="form-label">
                                        Button Value
                                        <small class="text-muted">(Radio buttons with the same Field Name but different Button Values form a mutually exclusive group)</small>
                                    </label>
                                    <input type="text" class="form-control form-control-sm"
                                           @bind="SelectedField.ButtonValue"
                                           @bind:after="() => MarkAsChanged(SelectedField)"
                                           placeholder="e.g., Yes, No, Option1, A, B, C" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        
        <!-- Right Panel: Visual Preview -->
        <div class="col-md-5">
            <div class="card">
                <div class="card-header">
                    <h5>Visual Preview</h5>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" @bind="ShowFieldOverlay">
                        <label class="form-check-label">Show Field Overlay</label>
                    </div>
                </div>
                <div class="card-body">
                    <div id="pdf-preview-container" style="position: relative; overflow: auto; max-height: 70vh;">
                        @if (PdfPreviewUrl != null)
                        {
                            <img src="@PdfPreviewUrl" style="width: 100%; height: auto;" />
                            
                            @if (ShowFieldOverlay && Fields != null)
                            {
                                <!-- Field overlay boxes -->
                                @foreach (var field in Fields.Where(f => f.PageNumber == CurrentPage))
                                {
                                    <div style="position: absolute;
                                              left: @(field.X * PreviewScale)px;
                                              top: @(field.Y * PreviewScale)px;
                                              width: @(field.Width * PreviewScale)px;
                                              height: @(field.Height * PreviewScale)px;
                                              border: 2px solid @(field.IsSelected ? "blue" : "red");
                                              background-color: @(field.IsSelected ? "rgba(0,0,255,0.2)" : "rgba(255,0,0,0.1)");
                                              cursor: pointer;"
                                         @onclick="() => SelectField(field)"
                                         title="@field.FieldName">
                                        <span style="font-size: 10px; background: white; padding: 2px;">
                                            @field.FieldName
                                        </span>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="alert alert-info">
                                PDF preview will appear here
                            </div>
                        }
                    </div>
                    
                    <!-- Page Navigation -->
                    @if (TotalPages > 1)
                    {
                        <div class="mt-2 text-center">
                            <button class="btn btn-sm btn-secondary" @onclick="PreviousPage" disabled="@(CurrentPage <= 1)">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <span class="mx-2">Page @CurrentPage of @TotalPages</span>
                            <button class="btn btn-sm btn-secondary" @onclick="NextPage" disabled="@(CurrentPage >= TotalPages)">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Field editing models
    private List<EditableFieldDetectionResult> Fields = new();
    private EditableFieldDetectionResult? SelectedField;
    private bool HasChanges = false;
    private string? ErrorMessage;

    // File handling
    private ElementReference fileInput;
    private string? CurrentFileName;
    private byte[]? CurrentPdfBytes;

    // Preview properties
    private string? PdfPreviewUrl;
    private int CurrentPage = 1;
    private int TotalPages = 1;
    private double PreviewScale = 1.0;
    private bool ShowFieldOverlay = true;
    
    // Field type options (matching the 33 types from specification)
    private readonly List<string> FieldTypes = new()
    {
        "text", "textarea", "checkbox", "radio", "dropdown", "date", "time", 
        "email", "phone", "ssn_full", "ssn_partial", "ein", "signature", 
        "initials", "numeric", "currency", "percentage", "file_upload",
        "case_number", "calculated", "protected", "conditional", "field_group",
        "full_name", "address", "url", "drivers_license", "gender_pronoun",
        "language_preference", "tin", "repeatable_section", "error_display",
        "compliance_acknowledgment"
    };
    
    protected override async Task OnInitializedAsync()
    {
        // Load fields from session or API
        await LoadFields();
    }
    
    private async Task LoadFieldsFromFile()
    {
        try
        {
            ErrorMessage = null;

            // Get file from input
            var files = await JSRuntime.InvokeAsync<IJSObjectReference>("getFiles", fileInput);
            if (files == null) return;

            var file = await JSRuntime.InvokeAsync<IJSObjectReference>("getFile", files, 0);
            if (file == null) return;

            var fileName = await JSRuntime.InvokeAsync<string>("getFileName", file);
            var fileBytes = await JSRuntime.InvokeAsync<byte[]>("getFileBytes", file);

            CurrentFileName = fileName;
            CurrentPdfBytes = fileBytes;

            // Call the load fields API
            using var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(fileBytes);
            fileContent.Headers.ContentType = MediaTypeHeaderValue.Parse("application/pdf");
            content.Add(fileContent, "file", fileName);

            var response = await Http.PostAsync("/api/fields/load", content);
            var responseContent = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = JsonSerializer.Deserialize<LoadFieldsResult>(responseContent,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (result?.Success == true && result.Fields != null)
                {
                    Fields = result.Fields.Select(f => new EditableFieldDetectionResult
                    {
                        ShortId = f.ShortId ?? "",
                        FieldName = f.FieldName ?? "",
                        FieldType = f.FieldType ?? "text",
                        PageNumber = f.PageNumber,
                        X = (float)f.X,
                        Y = (float)f.Y,
                        Width = (float)f.Width,
                        Height = (float)f.Height,
                        Tooltip = f.Tooltip ?? "",
                        Source = f.Source ?? "",
                        Confidence = f.Confidence,
                        TabIndex = f.TabIndex,
                        PageHeight = f.PageHeight
                    }).ToList();

                    TotalPages = result.TotalPages;
                    StateHasChanged();
                }
                else
                {
                    ErrorMessage = "Failed to parse field data from API response";
                }
            }
            else
            {
                ErrorMessage = $"Failed to load fields: {responseContent}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load fields: {ex.Message}";
        }
    }

    private async Task LoadFields()
    {
        // Add test data matching the form that was processed
        Fields = new List<EditableFieldDetectionResult>
        {
            new EditableFieldDetectionResult
            {
                ShortId = "Text1",
                FieldName = "Contract Number",
                FieldType = "text",
                PageNumber = 1,
                X = 520.32f,
                Y = 82.57f,
                Width = 50.0f,
                Height = 14.0f,
                PageHeight = 792,
                Source = "Syncfusion"
            },
            new EditableFieldDetectionResult
            {
                ShortId = "Field1",
                FieldName = "Customer Name",
                FieldType = "text",
                PageNumber = 1,
                X = 40.55f,
                Y = 114.40f,
                Width = 200.0f,
                Height = 14.0f,
                PageHeight = 792,
                Source = "Syncfusion"
            },
            new EditableFieldDetectionResult
            {
                ShortId = "Field2",
                FieldName = "Case ID",
                FieldType = "text",
                PageNumber = 1,
                X = 373.50f,
                Y = 114.40f,
                Width = 150.0f,
                Height = 14.0f,
                PageHeight = 792,
                Source = "Syncfusion"
            },
            new EditableFieldDetectionResult
            {
                ShortId = "Field3",
                FieldName = "Services Description",
                FieldType = "textarea",
                PageNumber = 1,
                X = 40.55f,
                Y = 150.50f,
                Width = 300.0f,
                Height = 14.0f,
                PageHeight = 792,
                Source = "Syncfusion"
            }
        };

        // Set a test PDF preview URL
        PdfPreviewUrl = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8/5+hHgAHggJ/PchI7wAAAABJRU5ErkJggg==";
        StateHasChanged();
    }
    
    private void SelectField(EditableFieldDetectionResult field)
    {
        // Deselect all fields
        Fields.ForEach(f => f.IsSelected = false);
        
        // Select this field
        field.IsSelected = true;
        SelectedField = field;
        
        // Navigate to the page containing this field
        if (field.PageNumber != CurrentPage)
        {
            CurrentPage = field.PageNumber;
        }
        
        StateHasChanged();
    }
    
    private void MarkAsChanged(EditableFieldDetectionResult field)
    {
        field.IsModified = true;
        HasChanges = true;
    }
    
    private void AddField()
    {
        var newField = new EditableFieldDetectionResult
        {
            ShortId = $"F{Fields.Count + 1}",
            FieldName = $"New Field {Fields.Count + 1}",
            FieldType = "text",
            PageNumber = CurrentPage,
            X = 100,
            Y = 100 + (Fields.Count * 30),
            Width = 200,
            Height = 20,
            PageHeight = 792,
            IsNew = true,
            IsModified = true
        };
        
        Fields.Add(newField);
        SelectField(newField);
        HasChanges = true;
    }
    
    private void RemoveField(EditableFieldDetectionResult field)
    {
        Fields.Remove(field);
        if (SelectedField == field)
        {
            SelectedField = null;
        }
        HasChanges = true;
    }
    
    private async Task SaveChanges()
    {
        try
        {
            if (CurrentPdfBytes == null || string.IsNullOrEmpty(CurrentFileName))
            {
                ErrorMessage = "No PDF file loaded. Please load a PDF first.";
                return;
            }

            ErrorMessage = null;

            // Get only the modified/new fields
            var modifiedFields = Fields.Where(f => f.IsModified || f.IsNew).ToList();

            if (!modifiedFields.Any())
            {
                await JSRuntime.InvokeVoidAsync("alert", "No changes to save.");
                return;
            }

            // Convert to API format
            var fieldUpdates = modifiedFields.Select(f => new
            {
                OriginalName = f.FieldName,
                NewName = f.FieldName,
                FieldType = f.FieldType,
                Tooltip = f.Tooltip,
                X = f.X,
                Y = f.Y,
                Width = f.Width,
                Height = f.Height,
                PageNumber = f.PageNumber
            }).ToList();

            // Call the save fields API
            using var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(CurrentPdfBytes);
            fileContent.Headers.ContentType = MediaTypeHeaderValue.Parse("application/pdf");
            content.Add(fileContent, "file", CurrentFileName);
            content.Add(new StringContent(JsonSerializer.Serialize(fieldUpdates)), "fields");

            var response = await Http.PostAsync("/api/fields/save", content);
            var responseContent = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = JsonSerializer.Deserialize<SaveFieldsResult>(responseContent,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (result?.Success == true)
                {
                    // Reset modification flags
                    Fields.ForEach(f => { f.IsModified = false; f.IsNew = false; });
                    HasChanges = false;

                    // Optionally update the CurrentPdfBytes with the new PDF
                    if (result.Pdf?.Data != null)
                    {
                        CurrentPdfBytes = Convert.FromBase64String(result.Pdf.Data);
                    }

                    await JSRuntime.InvokeVoidAsync("alert",
                        $"Successfully saved {modifiedFields.Count} field changes!");
                }
                else
                {
                    ErrorMessage = "Failed to save changes: Invalid API response";
                }
            }
            else
            {
                ErrorMessage = $"Failed to save changes: {responseContent}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to save changes: {ex.Message}";
        }
    }
    
    private async Task ExportFields()
    {
        var json = JsonSerializer.Serialize(Fields, new JsonSerializerOptions { WriteIndented = true });
        await JSRuntime.InvokeVoidAsync("downloadJson", json, "form-fields.json");
    }
    
    private void PreviousPage()
    {
        if (CurrentPage > 1) CurrentPage--;
    }
    
    private void NextPage()
    {
        if (CurrentPage < TotalPages) CurrentPage++;
    }
    
    // Extended field model for editing
    public class EditableFieldDetectionResult : FieldDetectionResult
    {
        public bool IsSelected { get; set; }
        public bool IsModified { get; set; }
        public bool IsNew { get; set; }
        public bool IsDeleted { get; set; }
        public string? Tooltip { get; set; }
        public string? ValidationPattern { get; set; }
        public int TabIndex { get; set; }
        public double PageHeight { get; set; }
    }

    // API response models
    public class LoadFieldsResult
    {
        public bool Success { get; set; }
        public List<ApiFieldInfo>? Fields { get; set; }
        public int TotalPages { get; set; }
        public string? Filename { get; set; }
    }

    public class ApiFieldInfo
    {
        public string? ShortId { get; set; }
        public string? FieldName { get; set; }
        public string? FieldType { get; set; }
        public int PageNumber { get; set; }
        public double X { get; set; }
        public double Y { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
        public double PageHeight { get; set; }
        public string? Tooltip { get; set; }
        public string? Source { get; set; }
        public float Confidence { get; set; }
        public int TabIndex { get; set; }
    }

    public class SaveFieldsResult
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public List<string>? ModifiedFields { get; set; }
        public PdfResult? Pdf { get; set; }
    }

    public class PdfResult
    {
        public string? Filename { get; set; }
        public string? Data { get; set; }
        public int Size { get; set; }
    }
}

<script>
    window.getFiles = (element) => {
        return element.files;
    };

    window.getFile = (files, index) => {
        return files[index];
    };

    window.getFileName = (file) => {
        return file.name;
    };

    window.getFileBytes = (file) => {
        return new Promise((resolve) => {
            const reader = new FileReader();
            reader.onload = (e) => {
                const arrayBuffer = e.target.result;
                const uint8Array = new Uint8Array(arrayBuffer);
                resolve(Array.from(uint8Array));
            };
            reader.readAsArrayBuffer(file);
        });
    };

    window.downloadJson = (json, filename) => {
        const blob = new Blob([json], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        a.click();
        URL.revokeObjectURL(url);
    };
</script>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
        cursor: pointer;
    }
    
    .sticky-top {
        position: sticky;
        top: 0;
        z-index: 10;
    }
    
    .form-control-sm, .form-select-sm {
        font-size: 0.875rem;
    }
</style>