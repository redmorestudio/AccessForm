    private async Task LoadPage(int pageNumber)
    {
        try
        {
            CurrentPage = pageNumber;
            
            // Call API to get page image
            using var client = new HttpClient();
            var content = new MultipartFormDataContent();
            content.Add(new ByteArrayContent(PdfBytes), "file", "document.pdf");
            content.Add(new StringContent(pageNumber.ToString()), "pageNumber");
            
            var response = await client.PostAsync("http://localhost:5002/api/pdf-page-preview", content);
            
