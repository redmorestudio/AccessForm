    private async Task<EditableField> FindFieldAtCoordinatesAsync(double clickX, double clickY)
    {
        // Find field at clicked coordinates using current page fields
        var pageFields = EditableFields.Where(f => f.Page == CurrentPage).ToList();

        await JSRuntime.InvokeVoidAsync("console.log", $"BLAZOR: Checking {pageFields.Count} fields on page {CurrentPage}");

        foreach (var field in pageFields)
        {
            // Use the same coordinate conversion as the server (PdfCoordinateConverter)
            const float SCALE_FACTOR = 150.0f / 72.0f; // Same as server
            const float STANDARD_PAGE_HEIGHT = 792.0f; // US Letter height

            // Convert PDF coordinates to display coordinates (same logic as server)
            var displayX = field.X * SCALE_FACTOR;
            var displayY = (STANDARD_PAGE_HEIGHT - field.Y) * SCALE_FACTOR;
            var displayWidth = field.Width * SCALE_FACTOR;
            var displayHeight = field.Height * SCALE_FACTOR;

            // For display, Y coordinate needs to be adjusted for field height since we converted bottom-left to top-left
            displayY -= displayHeight;

            await JSRuntime.InvokeVoidAsync("console.log",
                $"BLAZOR: Field '{field.Name}' bounds: PDF({field.X}, {field.Y}, {field.Width}, {field.Height}) -> Display({displayX:F1}, {displayY:F1}, {displayWidth:F1}, {displayHeight:F1})");

            // Check if click is within field bounds
            if (clickX >= displayX && clickX <= displayX + displayWidth &&
                clickY >= displayY && clickY <= displayY + displayHeight)
            {
                await JSRuntime.InvokeVoidAsync("console.log", $"BLAZOR: Click ({clickX}, {clickY}) is inside field '{field.Name}'");
                return field;
            }
        }

        await JSRuntime.InvokeVoidAsync("console.log", $"BLAZOR: Click ({clickX}, {clickY}) did not match any field bounds");
        return null;
    }

