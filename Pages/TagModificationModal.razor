            {
                var result = await response.Content.ReadAsStringAsync();
                var json = System.Text.Json.JsonDocument.Parse(result);
                
                CurrentPageImage = json.RootElement.GetProperty("imageData").GetString();
                
                // Get page dimensions and calculate scale
                double pdfPageWidth = 612; // Default US Letter width in points
                double pdfPageHeight = 792; // Default US Letter height in points
                
                if (json.RootElement.TryGetProperty("pageWidth", out var widthElement))
                {
                    pdfPageWidth = widthElement.GetDouble();
                }
                if (json.RootElement.TryGetProperty("pageHeight", out var heightElement))
                {
                    pdfPageHeight = heightElement.GetDouble();
                }
                
                // The image is rendered at 150 DPI, PDF coordinates are at 72 DPI
                // So we need to scale coordinates by 150/72 = 2.083
                ImageScale = 150.0 / 72.0;
                
                // Get fields from API response if available
                if (json.RootElement.TryGetProperty("fields", out var fieldsElement))
                {
                    CurrentPageFields.Clear();
                    foreach (var fieldJson in fieldsElement.EnumerateArray())
                    {
                        // Check if this field exists in our editable fields
                        var fieldName = fieldJson.GetProperty("name").GetString();
                        var editableField = EditableFields.FirstOrDefault(f => f.Name == fieldName && f.Page == pageNumber);
                        
                        if (editableField != null && fieldJson.TryGetProperty("x", out var x))
                        {
                            // Update positions from server
                            editableField.X = (float)x.GetDouble();
                            editableField.Y = (float)fieldJson.GetProperty("y").GetDouble();
                            editableField.Width = (float)fieldJson.GetProperty("width").GetDouble();
                            editableField.Height = (float)fieldJson.GetProperty("height").GetDouble();
                            
                            // Apply minimum sizes if fields are too small
                            // But handle checkboxes differently - they should be square and small
                            var fieldType = editableField.Type?.ToLower() ?? "text";
                            if (fieldType == "checkbox" || fieldType == "radio")
                            {
                                // Checkboxes should be square, typically 20x20
                                if (editableField.Width > editableField.Height * 2 || editableField.Width < 15)
                                {
                                    editableField.Width = 20;
                                    editableField.Height = 20;
                                }
                            }
                            else
                            {
                                // For text fields, apply minimum sizes
                                if (editableField.Width < 50) editableField.Width = 150;
                                if (editableField.Height < 15) editableField.Height = 20;
                            }
                            
                            Console.WriteLine($"Field {fieldName}: X={editableField.X}, Y={editableField.Y}, W={editableField.Width}, H={editableField.Height}");
                        }
                    }
