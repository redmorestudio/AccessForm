    private List<EditableField> GetSortedFields()
    {
        IEnumerable<EditableField> sorted = EditableFields;
        
        switch (sortBy)
        {
            case "name":
                sorted = sortAscending 
                    ? EditableFields.OrderBy(f => f.Name) 
                    : EditableFields.OrderByDescending(f => f.Name);
                break;
            case "type":
                sorted = sortAscending 
                    ? EditableFields.OrderBy(f => f.Type) 
                    : EditableFields.OrderByDescending(f => f.Type);
                break;
            case "page":
                sorted = sortAscending 
                    ? EditableFields.OrderBy(f => f.Page).ThenBy(f => f.Y).ThenBy(f => f.X)
                    : EditableFields.OrderByDescending(f => f.Page).ThenBy(f => f.Y).ThenBy(f => f.X);
                break;
            case "original":
            default:
                sorted = sortAscending 
                    ? EditableFields.OrderBy(f => f.OriginalIndex) 
                    : EditableFields.OrderByDescending(f => f.OriginalIndex);
                break;
        }
        
        return sorted.ToList();
    }
    
    private void SortFields(string column)
    {
        if (sortBy == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortBy = column;
            sortAscending = true;
        }
        StateHasChanged();
    }
    
    private void NavigateToField(int direction)
    {
        if (SelectedField == null) return;
        
        var sortedFields = GetSortedFields();
        var currentIndex = sortedFields.IndexOf(SelectedField);
        var newIndex = currentIndex + direction;
        
        if (newIndex >= 0 && newIndex < sortedFields.Count)
        {
            SelectedField = sortedFields[newIndex];
            
            // If on different page, load that page
            if (SelectedField.Page != CurrentPage)
            {
                _ = LoadPage(SelectedField.Page);
            }
            
            StateHasChanged();
        }
    }
    
    private void AutoGenerateTooltips()
    {
        foreach (var field in EditableFields)
        {
            field.Tooltip = AccessFormServer.Services.FieldTooltipGenerator.GenerateTooltip(field.Type, field.Name);
        }
        StateHasChanged();
    }
    
    private void ValidateAllFields()
    {
        ValidationMessages.Clear();
        
        foreach (var field in EditableFields)
        {
            // Check for duplicate field names
            var duplicates = EditableFields.Where(f => f != field && f.Name == field.Name).ToList();
            if (duplicates.Any())
            {
                ValidationMessages.Add($"Duplicate field name: '{field.Name}' on page {field.Page}");
            }
            
            // Check for missing tooltips
            if (string.IsNullOrWhiteSpace(field.Tooltip))
            {
                ValidationMessages.Add($"Field '{field.Name}' is missing a tooltip");
            }
            
            // Type-specific validation
            switch (field.Type)
            {
                case "email":
                    if (!field.Name.ToLower().Contains("email") && !field.Name.ToLower().Contains("e-mail"))
                    {
                        ValidationMessages.Add($"Field '{field.Name}' is marked as email but name doesn't suggest email");
                    }
                    break;
                    
                case "phone":
                    if (!field.Name.ToLower().Contains("phone") && !field.Name.ToLower().Contains("tel"))
                    {
                        ValidationMessages.Add($"Field '{field.Name}' is marked as phone but name doesn't suggest phone");
                    }
                    break;
                    
                case "date":
                    if (!field.Name.ToLower().Contains("date") && !field.Name.ToLower().Contains("dob"))
                    {
                        ValidationMessages.Add($"Field '{field.Name}' is marked as date but name doesn't suggest date");
                    }
                    break;
            }
        }
        
        if (!ValidationMessages.Any())
        {
            ValidationMessages.Add("✓ All fields passed validation!");
        }
        
        StateHasChanged();
    }
    
    private void OptimizeFieldTypes()
    {
        foreach (var field in EditableFields)
        {
            var detectedType = WordToPdfConverter.Services.FieldTypeDetector.DetectFieldType(field.Name, null, field.Type);
            if (detectedType != field.Type)
            {
                var compatibleType = AccessFormServer.Services.FieldTypeCompatibilityChecker.GetCompatibleType(field.Type, detectedType);
                if (compatibleType != field.Type)
                {
                    field.Type = compatibleType;
                }
            }
        }
        StateHasChanged();
    }
    
    private async Task RefreshFieldsFromPdf_OLD()
    {
        try
        {
            ValidationMessages.Clear();
            
            if (PdfBytes == null || PdfBytes.Length == 0)
            {
                ValidationMessages.Add("No PDF loaded");
                StateHasChanged();
                return;
            }
            
            // Extract actual form fields from the PDF
            using var client = new HttpClient();
            var content = new MultipartFormDataContent();
            content.Add(new ByteArrayContent(PdfBytes), "file", "document.pdf");
            
            var response = await client.PostAsync("http://localhost:5001/api/extract-pdf-fields", content);
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var fields = System.Text.Json.JsonDocument.Parse(json);
                
                // Create a map of current visual positions
                var currentPositions = EditableFields.ToDictionary(f => f.Name, f => new { f.X, f.Y, f.Width, f.Height });
                
                if (fields.RootElement.TryGetProperty("fields", out var fieldsArray))
                {
                    var pdfFields = new List<EditableField>();
                    
                    foreach (var field in fieldsArray.EnumerateArray())
                    {
                        var fieldName = field.GetProperty("name").GetString();
                        var newField = new EditableField
                        {
                            Name = fieldName,
                            OriginalName = fieldName, // Store original name
                            Type = field.GetProperty("type").GetString(),
                            Page = field.GetProperty("page").GetInt32(),
                            X = (float)field.GetProperty("x").GetDouble(),
                            Y = (float)field.GetProperty("y").GetDouble(),
                            Width = (float)field.GetProperty("width").GetDouble(),
                            Height = (float)field.GetProperty("height").GetDouble(),
                            Tooltip = field.TryGetProperty("tooltip", out var tt) ? tt.GetString() : "",
                            IsRequired = field.TryGetProperty("isRequired", out var req) ? req.GetBoolean() : false
                        };
                        
                        // If we have a visual position for a similar field, use that instead
                        if (currentPositions.ContainsKey(fieldName))
                        {
                            var pos = currentPositions[fieldName];
                            newField.X = pos.X;
                            newField.Y = pos.Y;
                            newField.Width = pos.Width;
                            newField.Height = pos.Height;
                        }
                        
                        pdfFields.Add(newField);
                    }
                    
                    // Keep existing fields that aren't in the PDF (visual-only fields)
                    var pdfFieldNames = new HashSet<string>(pdfFields.Select(f => f.Name));
                    var visualOnlyFields = EditableFields.Where(f => !pdfFieldNames.Contains(f.Name)).ToList();
                    
                    // Replace the field list
                    EditableFields.Clear();
                    EditableFields.AddRange(pdfFields);
                    
                    // Optionally add back visual-only fields
                    // EditableFields.AddRange(visualOnlyFields);
                    
                    ValidationMessages.Add($"Loaded {pdfFields.Count} PDF fields, kept visual positions where available");
                    await JSRuntime.InvokeVoidAsync("console.log", $"Refreshed {EditableFields.Count} fields from PDF");
                    
                    // Refresh the preview if showing field boxes
                    if (ShowFieldBoxes)
                    {
                        await LoadPageWithFieldBoxes(CurrentPage);
                    }
                }
                else
                {
                    ValidationMessages.Add("No form fields found in PDF");
                }
            }
            else
            {
                ValidationMessages.Add($"Failed to extract fields: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            ValidationMessages.Add($"Error refreshing fields: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("console.error", $"Error refreshing fields: {ex.Message}");
        }
        
        StateHasChanged();
    }
    
    private async Task ResetToOriginalFields()
    {
        try
        {
            ValidationMessages.Clear();
            
            // Reset to the original fields that were passed in
            if (originalOrder != null && originalOrder.Any())
            {
                EditableFields.Clear();
                EditableFields.AddRange(originalOrder.Select(f => new EditableField
                {
                    Name = f.Name,
                    OriginalName = f.OriginalName ?? f.Name,
                    Type = f.Type,
                    Tooltip = f.Tooltip,
                    IsRequired = f.IsRequired,
                    Page = f.Page,
                    X = f.X,
                    Y = f.Y,
                    Width = f.Width,
                    Height = f.Height,
                    OriginalIndex = f.OriginalIndex
                }));
                
                ValidationMessages.Add($"Reset to {EditableFields.Count} original fields");
                
                // Refresh the preview
                if (ShowFieldBoxes)
                {
                    await LoadPageWithFieldBoxes(CurrentPage);
                }
            }
            else
            {
                ValidationMessages.Add("No original fields to reset to");
            }
        }
        catch (Exception ex)
        {
            ValidationMessages.Add($"Error resetting fields: {ex.Message}");
        }
        
        StateHasChanged();
    }
    
