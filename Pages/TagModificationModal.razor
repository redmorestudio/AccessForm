    private async Task StartDrag(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, EditableField field)
    {
        IsDragging = true;
        SelectedField = field;
        DragStartX = e.ClientX;
        DragStartY = e.ClientY;
        FieldStartX = field.X;
        FieldStartY = field.Y;
        
        // Register mouse move and up handlers via JavaScript
        await JSRuntime.InvokeVoidAsync("startFieldDrag", 
            DotNetObjectReference.Create(this), field.Name);
    }
    
    private async Task StartResize(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, EditableField field)
    {
        IsResizing = true;
        SelectedField = field;
        DragStartX = e.ClientX;
        DragStartY = e.ClientY;
        FieldStartWidth = field.Width;
        FieldStartHeight = field.Height;
        
        // Register mouse move and up handlers via JavaScript
        await JSRuntime.InvokeVoidAsync("startFieldResize", 
            DotNetObjectReference.Create(this), field.Name);
    }
    
    [JSInvokable]
    public void UpdateFieldPosition(double deltaX, double deltaY)
    {
        if (IsDragging && SelectedField != null)
        {
            SelectedField.X = (float)(FieldStartX + deltaX / ImageScale);
            SelectedField.Y = (float)(FieldStartY + deltaY / ImageScale);
            
            // Ensure field stays within bounds
            SelectedField.X = Math.Max(0, SelectedField.X);
            SelectedField.Y = Math.Max(0, SelectedField.Y);
            
            StateHasChanged();
        }
    }
    
    [JSInvokable]
    public void UpdateFieldSize(double deltaX, double deltaY)
    {
        if (IsResizing && SelectedField != null)
        {
            SelectedField.Width = (float)(FieldStartWidth + deltaX / ImageScale);
            SelectedField.Height = (float)(FieldStartHeight + deltaY / ImageScale);
            
            // Minimum size constraints
            SelectedField.Width = Math.Max(20, SelectedField.Width);
            SelectedField.Height = Math.Max(10, SelectedField.Height);
            
            StateHasChanged();
        }
    }
    
    [JSInvokable]
    public async Task EndDragOrResize()
    {
        IsDragging = false;
        IsResizing = false;
        
        // Update the PDF preview with the new field positions/sizes
        await UpdatePdfPreview();
        
        StateHasChanged();
    }
    
