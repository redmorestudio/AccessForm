    }
    
    private void NavigateToField(int direction)
    {
        if (SelectedField == null) return;
        
        var sortedFields = GetSortedFields();
        var currentIndex = sortedFields.IndexOf(SelectedField);
        var newIndex = currentIndex + direction;
        
        if (newIndex >= 0 && newIndex < sortedFields.Count)
        {
            SelectedField = sortedFields[newIndex];
            
            // If on different page, load that page
            if (SelectedField.Page != CurrentPage)
            {
                _ = LoadPage(SelectedField.Page);
            }
            
            StateHasChanged();
        }
    }
    
