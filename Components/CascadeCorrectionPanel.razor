@using System.Text.Json
@using System.Net.Http
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<div class="cascade-correction-panel @(IsVisible ? "show" : "hide")" id="cascadeCorrectionPanel" style="position: fixed; right: 50px; top: 50px; width: 500px; height: calc(100vh - 100px); z-index: 1050;">
    @if (IsVisible)
    {
        <div class="card" style="height: 100%; display: flex; flex-direction: column; box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
            <div class="card-header bg-warning text-dark" id="cascadeWindowHeader" style="cursor: move; display: flex; justify-content: space-between; align-items: center;">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-triangle"></i> Field Cascade Correction
                </h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>
            <div class="card-body" style="flex: 1; overflow-y: auto;">
                @if (!string.IsNullOrEmpty(SessionId))
                {
                    <!-- Command Input -->
                    <div class="mb-3">
                        <div class="input-group">
                            <input type="text" class="form-control font-monospace" @bind="CommandInput"
                                   @onkeypress="@(async (e) => { if (e.Key == "Enter") await ExecuteCommand(); })"
                                   placeholder="Enter command: phantom 2, cascade 3, rename 5 'New Name', auto, preview, reset">
                            <button class="btn btn-primary" @onclick="ExecuteCommand">Execute</button>
                            <button class="btn btn-secondary" @onclick="RefreshTable">Refresh</button>
                        </div>
                        <small class="text-muted">Commands: phantom, cascade, rename, swap, auto, preview, reset, undo</small>
                    </div>

                    <!-- Quick Actions -->
                    <div class="btn-group mb-3" role="group">
                        <button class="btn btn-sm btn-outline-danger" @onclick="ExecuteAutoCommand">
                            <i class="bi bi-magic"></i> Auto Detect
                        </button>
                        <button class="btn btn-sm btn-outline-info" @onclick="ExecutePreviewCommand">
                            <i class="bi bi-eye"></i> Preview
                        </button>
                        <button class="btn btn-sm btn-outline-warning" @onclick="ExecuteResetCommand">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ExecuteUndoCommand">
                            <i class="bi bi-arrow-90deg-left"></i> Undo
                        </button>
                    </div>

                    <!-- Field Table -->
                    <div class="field-table-container" style="max-height: 400px; overflow-y: auto;">
                        <pre class="bg-dark text-light p-2 rounded font-monospace" style="font-size: 0.85em;">@FieldTableDisplay</pre>
                    </div>

                    <!-- Command Output -->
                    @if (!string.IsNullOrEmpty(CommandOutput))
                    {
                        <div class="mt-3">
                            <h6>Command Result:</h6>
                            <pre class="bg-light p-2 rounded font-monospace" style="font-size: 0.85em;">@CommandOutput</pre>
                        </div>
                    }

                    <!-- Apply Changes -->
                    <div class="mt-3">
                        <button class="btn btn-success" @onclick="ApplyCorrections">
                            <i class="bi bi-check-circle"></i> Apply Corrections
                        </button>
                        <button class="btn btn-secondary ms-2" @onclick="Close">Cancel</button>
                    </div>
                }
                else
                {
                    <div class="text-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Creating session...</span>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger mt-3" role="alert">
                        @ErrorMessage
                    </div>
                }
            </div>
        </div>
        <!-- Resize handles -->
        <div class="resize-handle resize-w" style="position: absolute; left: 0; top: 0; width: 5px; height: 100%; cursor: ew-resize;"></div>
        <div class="resize-handle resize-s" style="position: absolute; left: 0; bottom: 0; width: 100%; height: 5px; cursor: ns-resize;"></div>
        <div class="resize-handle resize-sw" style="position: absolute; left: 0; bottom: 0; width: 15px; height: 15px; cursor: nesw-resize;"></div>
    }
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public List<dynamic>? Fields { get; set; }
    [Parameter] public EventCallback<List<dynamic>> OnFieldsCorrected { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string? SessionId;
    private string CommandInput = "";
    private string FieldTableDisplay = "";
    private string CommandOutput = "";
    private string ErrorMessage = "";

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && Fields != null && Fields.Any())
        {
            if (string.IsNullOrEmpty(SessionId))
            {
                await CreateSession();
            }
            else
            {
                // Refresh session with current fields to pick up any new fields added
                await CreateSession();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && IsVisible)
        {
            await JSRuntime.InvokeVoidAsync("initializeResizableWindow", "cascadeCorrectionPanel", "cascadeWindowHeader");
        }
    }

    private async Task CreateSession()
    {
        try
        {
            ErrorMessage = "";

            // Convert fields to format expected by the API (FieldDetectionResult)
            var apiFields = Fields.Select((f, index) =>
            {
                var fieldElement = (JsonElement)f;
                return new
                {
                    ShortId = $"F{index + 1}",
                    FieldName = fieldElement.GetProperty("name").GetString(),
                    FieldType = fieldElement.TryGetProperty("type", out var typeElement) ? typeElement.GetString() : "text",
                    X = (float)fieldElement.GetProperty("x").GetDouble(),
                    Y = (float)fieldElement.GetProperty("y").GetDouble(),
                    Width = (float)fieldElement.GetProperty("width").GetDouble(),
                    Height = (float)fieldElement.GetProperty("height").GetDouble(),
                    CoordinateSystem = "PDF",
                    CoordinateOrigin = "Bottom-Left",
                    PageNumber = fieldElement.GetProperty("page").GetInt32(),
                    Source = "UI",
                    Confidence = 1.0f,
                    IsValid = true,
                    ValidationNotes = "",
                    Tooltip = "",
                    RequiredField = false,
                    HasValidCoordinates = true
                };
            }).ToList();

            var response = await Http.PostAsJsonAsync("/api/cascade-correction/session", apiFields);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<JsonElement>();
                SessionId = result.GetProperty("sessionId").GetString();
                await RefreshTable();
            }
            else
            {
                ErrorMessage = $"Failed to create cascade correction session: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error creating session: {ex.Message}";
        }
    }

    private async Task RefreshTable()
    {
        if (string.IsNullOrEmpty(SessionId)) return;

        try
        {
            var response = await Http.GetAsync($"/api/cascade-correction/{SessionId}");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<JsonElement>();

                if (result.TryGetProperty("displayTable", out var table))
                {
                    FieldTableDisplay = table.GetString() ?? "No field table available";
                }

                if (result.TryGetProperty("detectedIssues", out var issues))
                {
                    var issuesList = issues.EnumerateArray()
                        .Select(i => i.GetString())
                        .Where(i => !string.IsNullOrEmpty(i));

                    if (issuesList.Any())
                    {
                        CommandOutput = "Detected Issues:\n" + string.Join("\n", issuesList);
                    }
                }
            }
            else
            {
                ErrorMessage = $"Failed to refresh field table: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error refreshing table: {ex.Message}";
        }
    }

    private async Task ExecuteCommand()
    {
        if (string.IsNullOrEmpty(CommandInput) || string.IsNullOrEmpty(SessionId)) return;

        try
        {
            ErrorMessage = "";
            CommandOutput = "";

            // Parse command and args
            var parts = CommandInput.Split(' ', 2);
            var command = parts[0];
            var args = parts.Length > 1 ? ParseArgs(parts[1]) : Array.Empty<string>();

            var payload = new { command = command, args = args };
            var response = await Http.PostAsJsonAsync($"/api/cascade-correction/{SessionId}/command", payload);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<JsonElement>();

                if (result.TryGetProperty("message", out var message))
                {
                    CommandOutput = message.GetString() ?? "Command executed";
                }

                if (result.TryGetProperty("preview", out var preview))
                {
                    CommandOutput += "\n\nPreview:\n" + preview.GetString();
                }

                await RefreshTable();
                CommandInput = ""; // Clear input after successful execution
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ErrorMessage = $"Command failed: {error}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error executing command: {ex.Message}";
        }
    }

    private async Task ExecuteAutoCommand() => await ExecuteQuickCommand("auto");
    private async Task ExecutePreviewCommand() => await ExecuteQuickCommand("preview");
    private async Task ExecuteResetCommand() => await ExecuteQuickCommand("reset");
    private async Task ExecuteUndoCommand() => await ExecuteQuickCommand("undo");

    private async Task ExecuteQuickCommand(string command)
    {
        CommandInput = command;
        await ExecuteCommand();
    }

    private string[] ParseArgs(string argsString)
    {
        var args = new List<string>();
        var currentArg = "";
        var inQuotes = false;

        foreach (var c in argsString)
        {
            if (c == '"')
            {
                inQuotes = !inQuotes;
            }
            else if (c == ' ' && !inQuotes)
            {
                if (!string.IsNullOrEmpty(currentArg))
                {
                    args.Add(currentArg);
                    currentArg = "";
                }
            }
            else
            {
                currentArg += c;
            }
        }

        if (!string.IsNullOrEmpty(currentArg))
        {
            args.Add(currentArg);
        }

        return args.ToArray();
    }

    private async Task ApplyCorrections()
    {
        if (string.IsNullOrEmpty(SessionId)) return;

        try
        {
            ErrorMessage = "";

            var response = await Http.PostAsync($"/api/cascade-correction/{SessionId}/apply", null);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<JsonElement>();

                if (result.TryGetProperty("fields", out var fields))
                {
                    // Convert back to the format expected by the parent component
                    var correctedFields = fields.EnumerateArray()
                        .Select(f => (dynamic)f)
                        .ToList();

                    await OnFieldsCorrected.InvokeAsync(correctedFields);
                    await Close();
                }
            }
            else
            {
                ErrorMessage = $"Failed to apply corrections: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error applying corrections: {ex.Message}";
        }
    }

    private async Task Close()
    {
        SessionId = null;
        CommandInput = "";
        FieldTableDisplay = "";
        CommandOutput = "";
        ErrorMessage = "";
        await OnClose.InvokeAsync();
    }
}

<style>
    .cascade-correction-panel.hide {
        display: none;
    }

    .cascade-correction-panel.show {
        display: block;
    }

    .field-table-container {
        border: 1px solid #dee2e6;
        border-radius: 0.25rem;
    }

    .font-monospace {
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
    }
</style>